<html>
<head>
<title>SODashboard</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">SODashboard</td></tr>
</thead>
<tbody>
<tr>
	<td>PAGE_NAME</td>
	<td></td>
	<td>SODashboard</td>
</tr>
<tr>
	<td>SUCCESS_MESSAGE</td>
	<td>//div[@class='portlet-msg-success']</td>
	<td></td>
</tr>
<tr>
	<td>PROFILE_NAME</td>
	<td>//div[@id='so-sidebar']/div/a</td>
	<td></td>
</tr>
<tr>
	<td>CONFIRMATION</td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--NAVIGATION-->
<tr>
	<td>NAVIGATION_DASHBOARD</td>
	<td>//nav/ul/li[contains(.,'Dashboard')]/a/span</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_CONTACTS_CENTER</td>
	<td>//nav/ul/li[contains(.,'Contacts Center')]/a/span</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_MICROBLOGS</td>
	<td>//nav/ul/li[contains(.,'Microblogs')]/a/span</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_MESSAGES</td>
	<td>//nav/ul/li[contains(.,'Messages')]/a/span</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_MY_DOCUMENTS</td>
	<td>//nav/ul/li[contains(.,'My Documents')]/a/span</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_TASKS</td>
	<td>//nav/ul/li[contains(.,'Tasks')]/a/span</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_PAGE</td>
	<td>//nav/ul/li[contains(.,'${pageName}')]/a/span</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_PAGE_DELETE</td>
	<td>//li[9]/span[contains(@class,'delete-tab')]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--WHATS_HAPPENING-->
<tr>
	<td>WHATS_HAPPENING_CONTENT_FIELD</td>
	<td>//div[contains(@id,'_2_WAR_microblogsportlet_autocompleteContent')]</td>
	<td></td>
</tr>
<tr>
	<td>WHATS_HAPPENING_CONTENT_INPUT_FIELD</td>
	<td>//textarea[contains(@name,'contentInput')]</td>
	<td></td>
</tr>
<tr>
	<td>WHATS_HAPPENING_CONTENT_COUNTDOWN</td>
	<td>//span[@class='microblogs-countdown']</td>
	<td></td>
</tr>
<tr>
	<td>WHATS_HAPPENING_CONTENT_VIEW_FILTER</td>
	<td>//select[@id='_2_WAR_microblogsportlet_socialRelationType']</td>
	<td></td>
</tr>
<tr>
	<td>WHATS_HAPPENING_POST_BUTTON</td>
	<td>//input[@value='Post']</td>
	<td></td>
</tr>
<tr>
	<td>WHATS_HAPPENING_ENTRY_CONTENT</td>
	<td>//div[@class='entry-bubble']/div[@class='content']</td>
	<td></td>
</tr>
<tr>
	<td>WHATS_HAPPENING_INFO_MESSAGE</td>
	<td>//div[@class='portlet-msg-info']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--ANNOUNCEMENTS-->
<tr>
	<td>ANNOUNCEMENTS_ADD_ENTRY_BUTTON</td>
	<td>//input[@value='Add Entry']</td>
	<td></td>
</tr>
<tr>
	<td>ANNOUNCEMENTS_MANAGE_ENTRIES_BUTTON</td>
	<td>//input[@value='Manage Entries']</td>
	<td></td>
</tr>
<tr>
	<td>ANNOUNCEMENTS_ENTRY_ACTION</td>
	<td>//div[@class='entry-action']</td>
	<td></td>
</tr>
<tr>
	<td>ANNOUNCEMENTS_ENTRY_AUTHOR</td>
	<td>//div[@class='entry-action']/a</td>
	<td></td>
</tr>
<tr>
	<td>ANNOUNCEMENTS_ENTRY_TITLE</td>
	<td>//div[@class='entry-body']/div[@class='title']/a</td>
	<td></td>
</tr>
<tr>
	<td>ANNOUNCEMENTS_ENTRY_CONTENT</td>
	<td>//div[@class='entry-content']</td>
	<td></td>
</tr>
<tr>
	<td>ANNOUNCEMENTS_ENTRY_EDIT_LINK</td>
	<td>//span[@class='action edit-entry']/a</td>
	<td></td>
</tr>
<tr>
	<td>ANNOUNCEMENTS_ENTRY_DELETE_LINK</td>
	<td>//span[@class='action delete-entry']/span/a</td>
	<td></td>
</tr>
<tr>
	<td>ANNOUNCEMENTS_ENTRY_MARK_AS_READ_LINK</td>
	<td>//span[@class='action control-entry']/a</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--EVENTS_DISPLAY-->
<tr>
	<td>EVENTS_DISPLAY_TODAYS_EVENTS_EVENT_TITLE</td>
	<td>//div[@class='today-events']//span[@class='event-name']/a</td>
	<td></td>
</tr>
<tr>
	<td>EVENTS_DISPLAY_TODAYS_EVENTS_EVENT_CREATOR</td>
	<td>//div[@class='today-events']//span[@class='event-site']/a</td>
	<td></td>
</tr>
<tr>
	<td>EVENTS_DISPLAY_TODAYS_EVENTS_EVENT_TIME</td>
	<td>//div[@class='today-events']//span[@class='event-time']</td>
	<td></td>
</tr>
<tr>
	<td>EVENTS_DISPLAY_UPCOMING_EVENTS_EVENT_TITLE</td>
	<td>//div[@class='upcoming-events']//span[@class='event-name']/a</td>
	<td></td>
</tr>
<tr>
	<td>EVENTS_DISPLAY_UPCOMING_EVENTS_EVENT_CREATOR</td>
	<td>//div[@class='upcoming-events']//span[@class='event-site']/a</td>
	<td></td>
</tr>
<tr>
	<td>EVENTS_DISPLAY_UPCOMING_EVENTS_EVENT_TIME</td>
	<td>//div[@class='upcoming-events']//span[@class='event-time']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>