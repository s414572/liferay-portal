<definition>
	<property name="hook.plugins.includes" value="deploy-listener-hook,portal-compat-hook,so-activities-hook,so-hook" />
	<property name="portlet.plugins.includes" value="chat-portlet,contacts-portlet,events-display-portlet,microblogs-portlet,private-messaging-portlet,so-announcements-portlet,so-configurations-portlet,so-portlet,tasks-portlet,wysiwyg-portlet" />
	<property name="theme.plugins.includes" value="so-theme" />

	<set-up>
		<execute macro="SOUser#firstLoginPG" />
	</set-up>

	<var name="adminEmailAddress" value="test@liferay.com" />
	<var name="adminFirstName" value="Joe" />
	<var name="adminListName" value="Bloggs, Joe" />
	<var name="adminName" value="Joe Bloggs" />
	<var name="adminScreenName" value="joebloggs" />
	<var name="distributionScope" value="General" />
	<var name="entryContent" value="Announcements Entry Content" />
	<var name="entryContentEdit" value="Announcements Entry Content Edit" />
	<var name="entryTitle" value="Announcements Entry Title" />
	<var name="entryTitleEdit" value="Announcements Entry Title Edit" />
	<var name="entryURL" value="http://www.liferay.com" />
	<var name="eventDescription" value="Calendar Event Description" />
	<var name="eventTitle" value="Calendar Event Title" />
	<var name="microblogsEntryAuthorFirstName" value="Joe" />
	<var name="microblogsEntryAuthorLastName" value="Bloggs" />
	<var name="microblogsEntryAuthorScreenName" value="joebloggs" />
	<var name="microblogsEntryContent" value="Microblogs Post" />
	<var name="microblogsEntryCommentContent" value="Microblogs Post Comment" />
	<var name="microblogsEntryTagValue" value="Microblogs" />
	<var name="pageName" value="Calendar Page" />
	<var name="portletName" value="Calendar" />
	<var name="taskDescription" value="Task Description" />
	<var name="userEmailAddress" value="socialoffice01@liferay.com" />
	<var name="userFirstName" value="Social01" />
	<var name="userMiddleName" value="Office01" />
	<var name="userLastName" value="User01" />
	<var name="userListName" value="User01, Social01" />
	<var name="userName" value="Social01 Office01 User01" />
	<var name="userScreenName" value="socialoffice01" />
	<var name="whatsHappeningEntryAuthorFirstName" value="Joe" />
	<var name="whatsHappeningEntryAuthorLastName" value="Bloggs" />
	<var name="whatsHappeningEntryAuthorScreenName" value="joebloggs" />
	<var name="whatsHappeningEntryContent" value="Microblogs Post" />
	<var name="whatsHappeningEntryCharacterCountdown" value="135" />

	<command name="AddSOAnnouncementsEntry" priority="5">
		<execute action="SOUserBar#click" locator-key1="DASHBOARD" />

		<execute macro="SOAnnouncementsEntry#addPG">
			<var name="distributionScope" value="${distributionScope}" />
			<var name="entryAuthor" value="${entryContent}" />
			<var name="entryContent" value="${entryContent}" />
			<var name="entryTitle" value="${entryTitle}" />
			<var name="entryURL" value="${entryURL}" />
		</execute>

		<execute action="SOUserBar#click" locator-key1="DASHBOARD" />

		<execute macro="SOAnnouncementsEntry#viewPG">
			<var name="distributionScope" value="${distributionScope}" />
			<var name="entryAuthor" value="${adminName}" />
			<var name="entryContent" value="${entryContent}" />
			<var name="entryTitle" value="${entryTitle}" />
			<var name="entryURL" value="${entryURL}" />
		</execute>
	</command>

	<command name="AddWhatsHappeningEntryViewableByConnections" priority="5">
		<execute macro="SOUser#addUserWithSORole">
			<var name="adminEmailAddress" value="test@liferay.com" />
			<var name="password" value="test" />
			<var name="userEmailAddress" value="socialoffice01@liferay.com" />
			<var name="userFirstName" value="Social01" />
			<var name="userMiddleName" value="Office01" />
			<var name="userLastName" value="User01" />
			<var name="userScreenName" value="socialoffice01" />
		</execute>

		<execute macro="SODashboard#addWhatsHappeningEntry">
			<var name="whatsHappeningEntryContent" value="${whatsHappeningEntryContent}" />
			<var name="whatsHappeningEntryCharacterCountdown" value="${whatsHappeningEntryCharacterCountdown}" />
			<var name="whatsHappeningEntryViewableBy" value="Connections" />
		</execute>

		<execute macro="SOMicroblogs#viewOwnMicroblogsEntry">
			<var name="microblogsEntryAuthorFirstName" value="${whatsHappeningEntryAuthorFirstName}" />
			<var name="microblogsEntryAuthorLastName" value="${whatsHappeningEntryAuthorLastName}" />
		</execute>

		<execute macro="SOUser#logoutPG" />

		<execute macro="SOUser#loginPG">
			<var name="userEmailAddress" value="${userEmailAddress}" />
			<var name="password" value="test" />
		</execute>

		<execute macro="SOMicroblogs#viewMicroblogsEntryNone" />

		<execute macro="SOUser#logoutPG" />

		<execute macro="SOUser#loginPG">
			<var name="userEmailAddress" value="${adminEmailAddress}" />
			<var name="password" value="test" />
		</execute>

		<execute macro="SOContactsCenter#requestToConnect">
			<var name="userEmailAddress" value="${userEmailAddress}" />
			<var name="userListName" value="${userListName}" />
			<var name="userName" value="${userName}" />
			<var name="userScreenName" value="${userScreenName}" />
		</execute>

		<execute macro="SOUser#logoutPG" />

		<execute macro="SOUser#loginPG">
			<var name="userEmailAddress" value="${userEmailAddress}" />
			<var name="password" value="test" />
		</execute>

		<execute macro="SOContactsCenter#confirmRequestToConnect">
			<var name="senderName" value="${adminName}" />
			<var name="userName" value="${userName}" />
		</execute>

		<execute action="SOUserBar#click" locator-key1="DASHBOARD" />

		<execute action="SOActivities#assertClick" locator-key1="NAVIGATION_CONNECTIONS" value1="Connections" />

		<execute macro="SOActivities#viewMicroblogsNotViewableByEveryoneActivityEntry">
			<var name="userName" value="${whatsHappeningEntryAuthorFirstName} ${whatsHappeningEntryAuthorLastName}" />
			<var name="userFirstName" value="${whatsHappeningEntryAuthorFirstName}" />
		</execute>

		<execute macro="SOMicroblogs#viewMicroblogsEntryNotViewableByEveryone">
			<var name="microblogsEntryAuthorFirstName" value="${whatsHappeningEntryAuthorFirstName}" />
			<var name="microblogsEntryAuthorLastName" value="${whatsHappeningEntryAuthorLastName}" />
			<var name="microblogsEntryContent" value="${whatsHappeningEntryContent}" />
		</execute>
	</command>

	<command name="AddWhatsHappeningEntryViewableByEveryone" priority="5">
		<execute macro="SOUser#addUserWithSORole">
			<var name="adminEmailAddress" value="test@liferay.com" />
			<var name="password" value="test" />
			<var name="userEmailAddress" value="socialoffice01@liferay.com" />
			<var name="userFirstName" value="Social01" />
			<var name="userMiddleName" value="Office01" />
			<var name="userLastName" value="User01" />
			<var name="userScreenName" value="socialoffice01" />
		</execute>

		<execute macro="SODashboard#addWhatsHappeningEntry">
			<var name="whatsHappeningEntryContent" value="${whatsHappeningEntryContent}" />
			<var name="whatsHappeningEntryCharacterCountdown" value="${whatsHappeningEntryCharacterCountdown}" />
		</execute>

		<execute macro="SOMicroblogs#viewOwnMicroblogsEntry">
			<var name="microblogsEntryAuthorFirstName" value="${whatsHappeningEntryAuthorFirstName}" />
			<var name="microblogsEntryAuthorLastName" value="${whatsHappeningEntryAuthorLastName}" />
			<var name="microblogsEntryContent" value="${whatsHappeningEntryContent}" />
		</execute>

		<execute macro="SOUser#logoutPG" />

		<execute macro="SOUser#loginPG">
			<var name="userEmailAddress" value="${userEmailAddress}" />
			<var name="password" value="test" />
		</execute>

		<execute macro="SOMicroblogs#viewMicroblogsEntryViewableByEveryone">
			<var name="microblogsEntryAuthorFirstName" value="${whatsHappeningEntryAuthorFirstName}" />
			<var name="microblogsEntryAuthorLastName" value="${whatsHappeningEntryAuthorLastName}" />
			<var name="microblogsEntryAuthorScreenName" value="${whatsHappeningEntryAuthorScreenName}" />
			<var name="microblogsEntryContent" value="${whatsHappeningEntryContent}" />
		</execute>
	</command>

	<command name="AddWhatsHappeningEntryViewableByFollowers" priority="5">
		<execute macro="SOUser#addUserWithSORole">
			<var name="adminEmailAddress" value="test@liferay.com" />
			<var name="password" value="test" />
			<var name="userEmailAddress" value="socialoffice01@liferay.com" />
			<var name="userFirstName" value="Social01" />
			<var name="userMiddleName" value="Office01" />
			<var name="userLastName" value="User01" />
			<var name="userScreenName" value="socialoffice01" />
		</execute>

		<execute macro="SODashboard#addWhatsHappeningEntry">
			<var name="whatsHappeningEntryContent" value="${whatsHappeningEntryContent}" />
			<var name="whatsHappeningEntryCharacterCountdown" value="${whatsHappeningEntryCharacterCountdown}" />
			<var name="whatsHappeningEntryViewableBy" value="Followers" />
		</execute>

		<execute macro="SOMicroblogs#viewOwnMicroblogsEntry">
			<var name="microblogsEntryAuthorFirstName" value="${whatsHappeningEntryAuthorFirstName}" />
			<var name="microblogsEntryAuthorLastName" value="${whatsHappeningEntryAuthorLastName}" />
		</execute>

		<execute macro="SOUser#logoutPG" />

		<execute macro="SOUser#loginPG">
			<var name="userEmailAddress" value="${userEmailAddress}" />
			<var name="password" value="test" />
		</execute>

		<execute macro="SOMicroblogs#viewMicroblogsEntryNone" />

		<execute macro="SOContactsCenter#followUser">
			<var name="adminEmailAddress" value="${adminEmailAddress}" />
			<var name="adminListName" value="${adminListName}" />
			<var name="adminName" value="${adminName}" />
		</execute>

		<execute action="SOUserBar#click" locator-key1="DASHBOARD" />

		<execute action="SOActivities#assertClick" locator-key1="NAVIGATION_FOLLOWING" value1="Following" />

		<execute macro="SOActivities#viewMicroblogsNotViewableByEveryoneActivityEntry">
			<var name="userName" value="${whatsHappeningEntryAuthorFirstName} ${whatsHappeningEntryAuthorLastName}" />
			<var name="userFirstName" value="${whatsHappeningEntryAuthorFirstName}" />
		</execute>

		<execute macro="SOMicroblogs#viewMicroblogsEntryNotViewableByEveryone">
			<var name="microblogsEntryAuthorFirstName" value="${whatsHappeningEntryAuthorFirstName}" />
			<var name="microblogsEntryAuthorLastName" value="${whatsHappeningEntryAuthorLastName}" />
			<var name="microblogsEntryContent" value="${whatsHappeningEntryContent}" />
		</execute>
	</command>

	<command name="DeleteSOAnnouncementsEntry" priority="5">
		<execute action="SOUserBar#click" locator-key1="DASHBOARD" />

		<execute macro="SOAnnouncementsEntry#addPG">
			<var name="distributionScope" value="${distributionScope}" />
			<var name="entryContent" value="${entryContent}" />
			<var name="entryTitle" value="${entryTitle}" />
			<var name="entryURL" value="${entryURL}" />
		</execute>

		<execute action="SOUserBar#click" locator-key1="DASHBOARD" />

		<execute macro="SOAnnouncementsEntry#deletePG" />
	</command>

	<command name="EditSOAnnouncementsEntry" priority="5">
		<execute action="SOUserBar#click" locator-key1="DASHBOARD" />

		<execute macro="SOAnnouncementsEntry#addPG">
			<var name="distributionScope" value="${distributionScope}" />
			<var name="entryAuthor" value="${adminName}" />
			<var name="entryContent" value="${entryContent}" />
			<var name="entryTitle" value="${entryTitle}" />
			<var name="entryURL" value="${entryURL}" />
		</execute>

		<execute action="SOUserBar#click" locator-key1="DASHBOARD" />

		<execute macro="SOAnnouncementsEntry#editPG">
			<var name="distributionScope" value="${distributionScope}" />
			<var name="entryContentEdit" value="${entryContentEdit}" />
			<var name="entryTitleEdit" value="${entryTitleEdit}" />
			<var name="entryURL" value="${entryURL}" />
		</execute>

		<execute action="SOUserBar#click" locator-key1="DASHBOARD" />

		<execute macro="SOAnnouncementsEntry#viewPG">
			<var name="distributionScope" value="${distributionScope}" />
			<var name="entryAuthor" value="${adminName}" />
			<var name="entryContent" value="${entryContentEdit}" />
			<var name="entryTitle" value="${entryTitleEdit}" />
			<var name="entryURL" value="${entryURL}" />
		</execute>
	</command>

	<command name="MarkAsReadSOAnnouncementsEntry" priority="5">
		<execute action="SOUserBar#click" locator-key1="DASHBOARD" />

		<execute macro="SOAnnouncementsEntry#addPG">
			<var name="distributionScope" value="${distributionScope}" />
			<var name="entryContent" value="${entryContent}" />
			<var name="entryTitle" value="${entryTitle}" />
			<var name="entryURL" value="${entryURL}" />
		</execute>

		<execute action="SOUserBar#click" locator-key1="DASHBOARD" />

		<execute macro="SOAnnouncementsEntry#markAsReadPG">
			<var name="distributionScope" value="${distributionScope}" />
			<var name="entryAuthor" value="${adminName}" />
			<var name="entryContentEdit" value="${entryContent}" />
			<var name="entryTitleEdit" value="${entryTitle}" />
			<var name="entryURL" value="${entryURL}" />
		</execute>
	</command>

	<command name="MarkAsUnreadSOAnnouncementsEntry" priority="5">
		<execute action="SOUserBar#click" locator-key1="DASHBOARD" />

		<execute macro="SOAnnouncementsEntry#addPG">
			<var name="distributionScope" value="${distributionScope}" />
			<var name="entryContent" value="${entryContent}" />
			<var name="entryTitle" value="${entryTitle}" />
			<var name="entryURL" value="${entryURL}" />
		</execute>

		<execute action="SOUserBar#click" locator-key1="DASHBOARD" />

		<execute macro="SOAnnouncementsEntry#markAsReadPG">
			<var name="distributionScope" value="${distributionScope}" />
			<var name="entryAuthor" value="${adminName}" />
			<var name="entryContentEdit" value="${entryContent}" />
			<var name="entryTitleEdit" value="${entryTitle}" />
			<var name="entryURL" value="${entryURL}" />
		</execute>

		<execute action="SOUserBar#click" locator-key1="DASHBOARD" />

		<execute macro="SOAnnouncementsEntry#markAsUnreadPG">
			<var name="distributionScope" value="${distributionScope}" />
			<var name="entryAuthor" value="${adminName}" />
			<var name="entryContent" value="${entryContent}" />
			<var name="entryTitle" value="${entryTitle}" />
			<var name="entryURL" value="${entryURL}" />
		</execute>
	</command>

	<command name="ViewEventEventsDisplay" priority="5">
		<execute action="SOUserBar#click" locator-key1="DASHBOARD" />

		<execute macro="SODashboard#addPage">
			<var name="pageName" value="${pageName}" />
		</execute>

		<execute macro="SODashboard#addPortlet">
			<var name="pageName" value="${pageName}" />
		</execute>

		<execute macro="Event#addPG">
			<var name="eventTitle" value="${eventTitle}" />
			<var name="eventDescription" value="${eventDescription}" />
		</execute>

		<execute macro="SODashboard#viewTodaysEvent">
			<var name="eventTitle" value="${eventTitle}" />
			<var name="eventDescription" value="${eventDescription}" />
			<var name="userName" value="${adminName}" />
		</execute>

		<execute action="SODashboard#assertTextEquals" locator-key1="PROFILE_NAME" value1="${adminName}" />
	</command>

	<command name="ViewSiteEventEventsDisplay" priority="5">
		<var name="siteName" value="Open Site Name" />
		<var name="siteDescription" value="Open Site Description" />
		<var name="siteType" value="Open" />

		<execute macro="SOUserBar#addSOSite">
			<var name="siteName" value="${siteName}" />
			<var name="siteDescription" value="${siteDescription}" />
			<var name="siteType" value="${siteType}" />
		</execute>

		<execute macro="Page#gotoPG">
			<var name="pageName" value="Calendar" />
			<var name="pageType" value="Open Site" />
		</execute>

		<execute macro="Event#addPG">
			<var name="eventTitle" value="${eventTitle}" />
			<var name="eventDescription" value="${eventDescription}" />
		</execute>

		<execute macro="SODashboard#viewTodaysEventSiteEvent">
			<var name="eventTitle" value="${eventTitle}" />
			<var name="eventDescription" value="${eventDescription}" />
		</execute>

		<execute action="SOSiteHome#assertTextEquals" locator-key1="SITE_NAME" value1="${siteName}" />
	</command>

	<command name="ViewUpcomingTaskAssignedToConnection" priority="5">
		<execute macro="SOContactsCenter#addConnection">
			<var name="adminEmailAddress" value="${adminEmailAddress}" />
			<var name="senderName" value="${adminName}" />
			<var name="userEmailAddress" value="${userEmailAddress}" />
			<var name="userName" value="${userName}" />
			<var name="userFirstName" value="${userFirstName}" />
			<var name="userListName" value="${userListName}" />
			<var name="userLastName" value="${userLastName}" />
			<var name="userMiddleName" value="${userMiddleName}" />
			<var name="userScreenName" value="${userScreenName}" />
		</execute>

		<execute macro="SOUser#logoutPG" />

		<execute macro="SOUser#loginPG">
			<var name="userEmailAddress" value="${adminEmailAddress}" />
			<var name="password" value="test" />
		</execute>

		<execute macro="SONavigation#gotoDashboardTasks" />

		<execute macro="SOTasks#addTask">
			<var name="taskAssignee" value="${userName}" />
			<var name="taskReporter" value="${adminName}" />
			<var name="taskDescription" value="${taskDescription}" />
		</execute>

		<execute macro="SODashboard#viewUpcomingTask">
			<var name="taskAssignee" value="${userName}" />
			<var name="taskReporter" value="${adminName}" />
			<var name="taskDescription" value="${taskDescription}" />
		</execute>

		<execute macro="SOUser#logoutPG" />

		<execute macro="SOUser#loginPG">
			<var name="userEmailAddress" value="${userEmailAddress}" />
			<var name="password" value="test" />
		</execute>

		<execute macro="SODashboard#viewUpcomingTask">
			<var name="taskAssignee" value="${userName}" />
			<var name="taskReporter" value="${adminName}" />
			<var name="taskDescription" value="${taskDescription}" />
		</execute>
	</command>

	<command name="ViewUpcomingTaskAssignedToMe" priority="5">
		<execute macro="SONavigation#gotoDashboardTasks" />

		<execute macro="SOTasks#addTask">
			<var name="taskAssignee" value="${adminName}" />
			<var name="taskReporter" value="${adminName}" />
			<var name="taskDescription" value="${taskDescription}" />
		</execute>

		<execute macro="SODashboard#viewUpcomingTask">
			<var name="taskAssignee" value="${adminName}" />
			<var name="taskReporter" value="${adminName}" />
			<var name="taskDescription" value="${taskDescription}" />
		</execute>
	</command>

	<command name="ViewWhatsHappeningEntrySOUser" priority="5">
		<execute macro="SOContactsCenter#addConnection">
			<var name="adminEmailAddress" value="${adminEmailAddress}" />
			<var name="senderName" value="${adminName}" />
			<var name="userEmailAddress" value="${userEmailAddress}" />
			<var name="userName" value="${userName}" />
			<var name="userFirstName" value="${userFirstName}" />
			<var name="userListName" value="${userListName}" />
			<var name="userLastName" value="${userLastName}" />
			<var name="userMiddleName" value="${userMiddleName}" />
			<var name="userScreenName" value="${userScreenName}" />
		</execute>

		<execute macro="SOUser#logoutPG" />

		<execute macro="SOUser#loginPG">
			<var name="userEmailAddress" value="${adminEmailAddress}" />
			<var name="password" value="test" />
		</execute>

		<execute macro="SOMicroblogs#gotoMicroblogsContentField" />

		<execute macro="SOMicroblogs#addMicroblogsEntryMention">
			<var name="mentionUserEmailAddress" value="${userEmailAddress}" />
			<var name="mentionUserFirstName" value="${userFirstName}" />
			<var name="mentionUserListName" value="${userListName}" />
			<var name="mentionUserLastName" value="${userLastName}" />
			<var name="mentionUserMiddleName" value="${userMiddleName}" />
			<var name="mentionUserName" value="${userName}" />
			<var name="mentionUserScreenName" value="${userScreenName}" />
		</execute>

		<execute macro="SOMicroblogs#viewOwnMicroblogsEntryMention">
			<var name="microblogsEntryAuthorFirstName" value="${microblogsEntryAuthorFirstName}" />
			<var name="microblogsEntryAuthorLastName" value="${microblogsEntryAuthorLastName}" />
			<var name="mentionUserName" value="${userName}" />
		</execute>

		<execute macro="SOUser#logoutPG" />

		<execute macro="SOUser#loginPG">
			<var name="userEmailAddress" value="${userEmailAddress}" />
			<var name="password" value="test" />
		</execute>

		<execute action="SOUserBar#click" locator-key1="DASHBOARD" />

		<execute action="SODashboard#click" locator-key1="NAVIGATION_MICROBLOGS" />

		<execute macro="SOMicroblogs#addMicroblogsEntryComment">
			<var name="microblogsEntryAuthorFirstName" value="${microblogsEntryAuthorFirstName}" />
			<var name="microblogsEntryAuthorLastName" value="${microblogsEntryAuthorLastName}" />
			<var name="microblogsEntryContent" value="${userName}" />
			<var name="microblogsEntryCommentContent" value="${microblogsEntryCommentContent}" />
		</execute>

		<execute macro="SOMicroblogs#gotoMicroblogsContentField" />

		<execute macro="SOMicroblogs#addMicroblogsEntry">
			<var name="microblogsEntryContent" value="${microblogsEntryContent}" />
		</execute>

		<execute action="SOUserBar#click" locator-key1="DASHBOARD" />

		<execute action="SODashboard#assertTextEquals" locator-key1="WHATS_HAPPENING_ENTRY_CONTENT" value1="${microblogsEntryContent}" />
		<execute action="SODashboard#assertTextNotPresent" value1="Microblogs Post Comment" />
		<execute action="SODashboard#click" locator-key1="NAVIGATION_MICROBLOGS" />

		<execute macro="SOMicroblogs#viewMicroblogsEntryAuthor">
			<var name="microblogsEntryAuthorFirstName" value="${userFirstName}" />
			<var name="microblogsEntryAuthorMiddleName" value="${userMiddleName}" />
			<var name="microblogsEntryAuthorLastName" value="${userLastName}" />
		</execute>

		<execute action="SOMicroblogs#assertTextEquals" locator-key1="MICROBLOGS_ENTRY_CONTENT" value1="${microblogsEntryContent}" />

		<execute macro="SOMicroblogs#viewMicroblogsEntryCommentLink" />

		<execute action="SOMicroblogs#assertTextEquals" locator1="xpath=(//div[@class='user-name']/span/a)[2]" value1="${adminName}" />
		<execute action="SOMicroblogs#assertTextEquals" locator1="xpath=(//div[@class='content'])[2]" value1="${userName}" />
		<execute action="SOMicroblogs#assertTextEquals" locator1="xpath=(//span[@class='action comment']/a)[2]" value1="1 Comment" />
		<execute action="SOMicroblogs#assertTextEquals" locator-key1="MICROBLOGS_ENTRY_REPOST_LINK" value1="Repost" />
	</command>

	<tear-down>
		<execute macro="SOMicroblogs#tearDownMicroblogsEntry" />

		<execute macro="SOAnnouncementsEntry#tearDownPG" />

		<execute macro="SOUser#tearDownCP" />

		<execute macro="SOCalendar#tearDownCP" />

		<execute macro="SODashboard#tearDownPG" />

		<execute macro="SOUserBar#tearDownNotifications" />

		<execute macro="SOTasks#tearDownTask" />

		<execute macro="SOUserBar#tearDownSites" />
	</tear-down>
</definition>