<html>
<head>
<title>SOTasks</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">SOTasks</td></tr>
</thead>
<tbody>
<tr>
	<td>PAGE_NAME</td>
	<td></td>
	<td>SOTasks</td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>ASSIGNED_TO_ME_LINK</td>
	<td>//a[contains(.,'Assigned to Me')]</td>
	<td></td>
</tr>
<tr>
	<td>I_HAVE_CREATED_LINK</td>
	<td>//a[contains(.,'I Have Created')]</td>
	<td></td>
</tr>
<tr>
	<td>ADD_TASK_BUTTON</td>
	<td>//a[@class='add-task']</td>
	<td></td>
</tr>
<tr>
	<td>PERMISSIONS_BUTTON</td>
	<td>//a[@class='permission-tasks']</td>
	<td></td>
</tr>
<tr>
	<td>FILTER_BUTTON</td>
	<td>//a[@class='filter-tasks']</td>
	<td></td>
</tr>
<tr>
	<td>INFO_MESSAGE</td>
	<td>//div[@class='portlet-msg-info']</td>
	<td></td>
</tr>
<tr>
	<td>SHOW_COMPLETED_TASKS_CHECKBOX</td>
	<td>//input[@name='all-tasks']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--FILTER-->
<tr>
	<td>FILTER_TAG_HEADER</td>
	<td>//h3[contains(.,'Filter by Tags')]</td>
	<td></td>
</tr>
<tr>
	<td>FILTER_TAG_CHECKBOX</td>
	<td>//span[contains(@class,'asset-tag')]/a[contains(.,'${tagNumber}')]</td>
	<td></td>
</tr>
<tr>
	<td>FILTER_PLACE_HEADER</td>
	<td>//h3[contains(.,'Filter by Place')]</td>
	<td></td>
</tr>
<tr>
	<td>FILTER_PLACE_SELECT_MENU</td>
	<td>//div[@class='filter-container group-filter']/select</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--TASK-->
<tr>
	<td>TASK_DESCRIPTION</td>
	<td>//a[contains(@class,'tasks-title')]</td>
	<td></td>
</tr>
<tr>
	<td>TASK_DESCRIPTION_NORMAL</td>
	<td>//a[@class='tasks-title normal']</td>
	<td></td>
</tr>
<tr>
	<td>TASK_DESCRIPTION_NORMAL_INCREMENT</td>
	<td>xpath=(//a[@class='tasks-title normal'])[contains(.,'${number}')]</td>
	<td></td>
</tr>
<tr>
	<td>TASK_DESCRIPTION_HIGH</td>
	<td>//a[@class='tasks-title high']</td>
	<td></td>
</tr>
<tr>
	<td>TASK_DESCRIPTION_HIGH_INCREMENT</td>
	<td>xpath=(//a[@class='tasks-title high'])[contains(.,'${key_number}')]</td>
	<td></td>
</tr>
<tr>
	<td>TASK_DESCRIPTION_LOW</td>
	<td>//a[@class='tasks-title low']</td>
	<td></td>
</tr>
<tr>
	<td>TASK_DESCRIPTION_LOW_INCREMENT</td>
	<td>xpath=(//a[@class='tasks-title low'])[contains(.,'${number}')]</td>
	<td></td>
</tr>
<tr>
	<td>TASK_REPORTER</td>
	<td>//div[@class='result-data']/span[contains(.,'Reporter')]</td>
	<td></td>
</tr>
<tr>
	<td>TASK_ASSIGNEE</td>
	<td>//div[@class='result-data']/span[contains(.,'Assignee')]</td>
	<td></td>
</tr>
<tr>
	<td>TASK_PROGRESS_BAR</td>
	<td>//div[contains(@class,'progress-picker')]</td>
	<td></td>
</tr>
<tr>
	<td>TASK_PROGRESS_BAR_PERCENT_CLICK</td>
	<td>//div[contains(@class,'progress-picker')]/div[@class='progress-selector']/a[@class='progress-${percentCompletion}']</td>
	<td></td>
</tr>
<tr>
	<td>TASK_PROGRESS_BAR_PERCENT_COMPLETION</td>
	<td>//div[@class='progress' and contains(@style,'${percentCompletion}%')]</td>
	<td></td>
</tr>
<tr>
	<td>FILTER_PLACE_SELECT_MENU</td>
	<td>//div[@class='filter-container group-filter']/select</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>