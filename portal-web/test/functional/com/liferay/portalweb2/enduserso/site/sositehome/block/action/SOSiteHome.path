</tr>
<tr>
	<td>RSS_FEED_DESCRIPTION</td>
	<td>//div[contains(.,'${feedTitle}')]/div[@class='feed-description']</td>
	<td></td>
</tr>
<tr>
	<td>RSS_FEED_IMAGE</td>
	<td>//a[contains(@title,'${feedTitle}')]/img</td>
	<td></td>
</tr>
<tr>
	<td>RSS_FEED_ENTRY_TITLE_INCREMENT</td>
	<td>xPath=(//div[contains(.,'${feedTitle}')]/div[@class='feed-entries']/div[@class='feed-entry']/span[@class='feed-entry-title'])[${feedEntryNumber}]</td>
	<td></td>
</tr>
<tr>
	<td>RSS_FEED_ENTRY_EXPAND_BUTTON_INCREMENT</td>
	<td>xPath=(//div[contains(.,'${feedTitle}')]/div[@class='feed-entries']/div[@class='feed-entry']/img)[${feedEntryNumber}]</td>
	<td></td>
</tr>
<tr>
	<td>RSS_FEED_ENTRY_DATE_AND_TIME_INCREMENT</td>
	<td>xPath=(//div[contains(.,'${feedTitle}')]/div[@class='feed-entries']/div[@class='feed-entry']/div[contains(@class,'feed-entry-content')]/div[@class='feed-date'])[${feedEntryNumber}]</td>
	<td></td>
</tr>
<tr>
	<td>RSS_FEED_ENTRY_AUTHOR_INCREMENT</td>
	<td>xPath=(//div[contains(.,'${feedTitle}')]/div[@class='feed-entries']/div[@class='feed-entry']/div[contains(@class,'feed-entry-content')]/span[@class='feed-entry-author'])[${feedEntryNumber}]</td>
	<td></td>
</tr>
<tr>
	<td>RSS_FEED_ENTRY_CONTENT_INCREMENT</td>
	<td>xPath=(//div[contains(.,'${feedTitle}')]/div[@class='feed-entries']/div[@class='feed-entry']/div[contains(@class,'feed-entry-content')])[${feedEntryNumber}]</td>
	<td></td>
</tr>
<tr>
	<td>RSS_FEED_ENTRY_CONTENT_READ_MORE_INCREMENT</td>
	<td>xPath=(//div[contains(.,'${feedTitle}')]/div[@class='feed-entries']/div[@class='feed-entry']/div[contains(@class,'feed-entry-content')]/a)[${feedEntryNumber}]</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
