<html>
<head>
<title>SOSiteHome</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3">SOSiteHome</td></tr>
</thead>
<tbody>
<tr>
	<td>PAGE_NAME</td>
	<td></td>
	<td>SOSiteHome</td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td>SITE_NAME</td>
	<td>//div[@class='community-title']/a/span</td>
	<td></td>
</tr>
<tr>
	<td>SITE_JOIN_LINK</td>
	<td>//span[@class='action request']/a</td>
	<td></td>
</tr>
<tr>
	<td>SITE_MEMBERSHIP_REQUESTED</td>
	<td>//span[@class='action requested']/a</td>
	<td></td>
</tr>
<tr>
	<td>SUCCESS_MESSAGE</td>
	<td>//div[@class='portlet-msg-success']</td>
	<td></td>
</tr>
<tr>
	<td>CONFIRMATION</td>
	<td></td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--NAVIGATION-->
<tr>
	<td>NAVIGATION_HOME</td>
	<td>//nav/ul/li[contains(.,'Home')]/a/span</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_CALENDAR</td>
	<td>//nav/ul/li[contains(.,'Calendar')]/a/span</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_DOCUMENTS</td>
	<td>//nav/ul/li/a/span[.=' Documents']</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_FORUMS</td>
	<td>//nav/ul/li[contains(.,'Forums')]/a/span</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_BLOGS</td>
	<td>//nav/ul/li[contains(.,'Blogs')]/a/span</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_WIKI</td>
	<td>//nav/ul/li[contains(.,'Wiki')]/a/span</td>
	<td></td>
</tr>
<tr>
	<td>NAVIGATION_MEMBERS</td>
	<td>//nav/ul/li[contains(.,'Members')]/a/span</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--BOOKMARKS-->
<tr>
	<td>BOOKMARKS_ADD_ENTRY_LINK</td>
	<td>//a[contains(.,'Add Entry')]</td>
	<td></td>
</tr>
<tr>
	<td>BOOKMARKS_ENTRY_LINK</td>
	<td>//td[@id='_28_bookmarksEntriesSearchContainer_col-name_row-1']/a</td>
	<td></td>
</tr>
<tr>
	<td>BOOKMARKS_ENTRY_LINK_INCREMENT</td>
	<td>//tr[contains(.,'${number}')]/td/a</td>
	<td></td>
</tr>
<tr>
	<td>BOOKMARKS_ENTRY_ACTIONS</td>
	<td>//span[@title='Actions']/ul/li/strong/a</td>
	<td></td>
</tr>
<tr>
	<td>BOOKMARKS_ENTRY_ACTIONS_INCREMENT</td>
	<td>//tr[contains(.,'${number}')]//span[@title='Actions']/ul/li/strong/a</td>
	<td></td>
</tr>
<tr>
	<td>BOOKMARKS_NO_ENTRIES_MESSAGE</td>
	<td>//div[@class='portlet-body']/form[contains(.,'There are no entries')]</td>
	<td></td>
</tr>
<tr>
	<td>VERSION_HISTORY_SIZE</td>
	<td>//span[@class='size']</td>
	<td></td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--BOOKMARKS_ACTIONS_MENULIST-->
<tr>
	<td>ACTIONS_MENULIST_EDIT</td>
	<td>//div[@class='lfr-component lfr-menu-list']/ul/li[1]/a[contains(.,'Edit')]</td>
	<td>Cancel Checkout</td>
</tr>
<tr>
	<td>ACTIONS_MENULIST_PERMISSIONS</td>
	<td>//div[@class='lfr-component lfr-menu-list']/ul/li[2]/a[contains(.,'Permissions')]</td>
	<td>Checkin</td>
</tr>
<tr>
	<td>ACTIONS_MENULIST_DELETE</td>
	<td>//div[@class='lfr-component lfr-menu-list']/ul/li[3]/a[contains(.,'Delete')]</td>
	<td>Checkout</td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--BOOKMARKS_POP_UP-->
<tr>
	<td>BOOKMARKS_POP_UP_GOOGLE</td>
	<td>title=Google</td>
	<td>Google</td>
</tr>
<tr>
	<td>BOOKMARKS_POP_UP_YAHOO</td>
	<td>title=Yahoo</td>
	<td>Yahoo</td>
</tr>
<tr>
	<td>BOOKMARKS_POP_UP_MSN</td>
	<td>title=MSN.com</td>
	<td>MSN</td>
</tr>
<tr>
	<td>BOOKMARKS_POP_UP_IMAGE_GOOGLE</td>
	<td>xPath=(//button[@aria-label='Google Search'])[2]</td>
	<td>Google</td>
</tr>
<tr>
	<td>BOOKMARKS_POP_UP_IMAGE_YAHOO</td>
	<td>//button[@id='search-submit']</td>
	<td>Yahoo</td>
</tr>
<tr>
	<td>BOOKMARKS_POP_UP_IMAGE_MSN</td>
	<td>//img[@alt='MSN Logo']</td>
	<td>MSN</td>
</tr>
<tr>
	<td>BOOKMARKS_NULL_WINDOW</td>
	<td>null</td>
	<td>Bookmarks Null Window</td>
</tr>
<tr>
	<td></td>
	<td></td>
	<td></td>
</tr>
<!--EVENTS_DISPLAY-->
<tr>
	<td>EVENTS_DISPLAY_TODAYS_EVENTS_EVENT_TITLE</td>
	<td>//div[@class='today-events']//span[@class='event-name']/a</td>
	<td></td>
</tr>
<tr>
	<td>EVENTS_DISPLAY_TODAYS_EVENTS_EVENT_TIME</td>
	<td>//div[@class='today-events']//span[@class='event-time']</td>
	<td></td>
</tr>
<tr>
	<td>EVENTS_DISPLAY_UPCOMING_EVENTS_EVENT_TITLE</td>
	<td>//div[@class='upcoming-events']//span[@class='event-name']/a</td>
	<td></td>
</tr>
<tr>
	<td>EVENTS_DISPLAY_UPCOMING_EVENTS_EVENT_TIME</td>
	<td>//div[@class='upcoming-events']//span[@class='event-time']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>