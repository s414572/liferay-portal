	<td></td>
</tr>
<tr>
	<td>RSS_FEED_TITLE</td>
	<td>//div[contains(.,'${feedTitle}')]/div[@class='feed-title']</td>
	<td></td>
</tr>
<tr>
	<td>RSS_FEED_PUBLISHED_DATE</td>
	<td>//div[contains(.,'${feedTitle}')]/div[contains(@class,'feed-published-date')]</td>
