<definition>
	<command name="assertClick">
		<case locator-key1="NAVIGATION_CONNECTIONS">
			<execute function="AssertClick#assertTextClickAtAndWait" />
		</case>

		<case locator-key1="NAVIGATION_FOLLOWING">
			<execute function="AssertClick#assertTextClickAtAndWait" />
		</case>
	</command>
</definition>