<definition>
	<command name="addCP">
		<execute action="CPCalendar#assertClick" locator-key1="VIEW_SUMMARY" value1="Summary" />
		<execute action="CPCalendar#assertClick" locator-key1="ADD_EVENT_BUTTON" value1="Add Event" />

		<execute action="CPCalendarAddEvent#type" locator-key1="TITLE_FIELD" value1="${eventTitle}" />
		<execute action="CPCalendarAddEvent#assertClick" locator-key1="SAVE_BUTTON" value1="Save" />

		<execute action="CPCalendar#assertTextEquals" locator-key1="SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute action="CPCalendar#assertElementPresent" locator-key1="EVENT_TABLE_TIME" />
		<execute action="CPCalendar#assertTextEquals" locator-key1="EVENT_TABLE_TITLE" value1="${eventTitle}" />
		<execute action="CPCalendar#assertTextEquals" locator-key1="EVENT_TABLE_TYPE" value1="Anniversary" />
		<execute action="CPCalendar#assertTextEquals" locator-key1="EVENT_TABLE_ACTIONS" value1="Actions" />
	</command>

	<command name="addPG">
		<var name="key_eventTitle" value="${eventTitle}" />

		<if>
			<isset var="daysIntoFuture" />
			<then>
				<var name="dayNumber" value="0" />

				<execute action="PGCalendar#assertClick" locator-key1="VIEW_DAY" value1="Day" />

				<while>
					<not>
						<equals arg1="${dayNumber}" arg2="${daysIntoFuture}" />
					</not>
					<then>
						<var name="dayNumber" value="${dayNumber?increment()}" />

						<execute action="PGCalendar#click" locator-key1="NEXT_BUTTON" />
					</then>
				</while>
			</then>
			<else>
				<execute action="PGCalendar#assertClick" locator-key1="VIEW_SUMMARY" value1="Summary" />
			</else>
		</if>

		<execute action="PGCalendar#assertClick" locator-key1="ADD_EVENT_BUTTON" value1="Add Event" />

		<if>
			<isset var="number" />
			<then>
				<var name="number" value="${number}" />

				<execute action="PGCalendarAddEvent#type" locator-key1="TITLE_FIELD" value1="${eventTitle}${number}" />
				<execute action="PGCalendarAddEvent#type" locator-key1="DESCRIPTION_FIELD" value1="${eventDescription}${number}" />
				<execute action="PGCalendarAddEvent#assertClick" locator-key1="SAVE_BUTTON" value1="Save" />

				<execute action="PGCalendar#assertTextEquals" locator-key1="SUCCESS_MESSAGE" value1="Your request completed successfully." />
				<execute action="PGCalendar#assertClick" locator-key1="VIEW_SUMMARY" value1="Summary" />
				<execute action="PGCalendar#assertElementPresent" locator-key1="EVENT_TABLE_TIME_INCREMENT" />
				<execute action="PGCalendar#assertTextEquals" locator-key1="EVENT_TABLE_TITLE_INCREMENT" value1="${eventTitle}${number}" />
				<execute action="PGCalendar#assertTextEquals" locator-key1="EVENT_TABLE_TYPE_INCREMENT" value1="Anniversary" />
				<execute action="PGCalendar#assertTextEquals" locator-key1="EVENT_TABLE_ACTIONS_INCREMENT" value1="Actions" />
			</then>
			<else>
				<execute action="PGCalendarAddEvent#type" locator-key1="TITLE_FIELD" value1="${eventTitle}" />
				<execute action="PGCalendarAddEvent#type" locator-key1="DESCRIPTION_FIELD" value1="${eventDescription}" />
				<execute action="PGCalendarAddEvent#assertClick" locator-key1="SAVE_BUTTON" value1="Save" />

				<execute action="PGCalendar#assertTextEquals" locator-key1="SUCCESS_MESSAGE" value1="Your request completed successfully." />
				<execute action="PGCalendar#assertClick" locator-key1="VIEW_SUMMARY" value1="Summary" />
				<execute action="PGCalendar#assertElementPresent" locator-key1="EVENT_TABLE_TIME" />
				<execute action="PGCalendar#assertTextEquals" locator-key1="EVENT_TABLE_TITLE" value1="${eventTitle}" />
				<execute action="PGCalendar#assertTextEquals" locator-key1="EVENT_TABLE_TYPE" value1="Anniversary" />
				<execute action="PGCalendar#assertTextEquals" locator-key1="EVENT_TABLE_ACTIONS" value1="Actions" />
			</else>
		</if>
	</command>

	<command name="addRepeatMonthlyPG">
		<var name="key_eventTitle" value="${eventTitle}" />

		<execute action="PGCalendar#assertClick" locator-key1="ADD_EVENT_BUTTON" value1="Add Event" />

		<execute action="PGCalendarAddEvent#select" locator-key1="START_DATE_MONTH_SELECT" value1="${eventStartMonth}" />
		<execute action="PGCalendarAddEvent#select" locator-key1="START_DATE_DAY_SELECT" value1="${eventStartDay}" />
		<execute action="PGCalendarAddEvent#select" locator-key1="START_DATE_YEAR_SELECT" value1="${eventStartYear}" />
		<execute action="PGCalendarAddEvent#type" locator-key1="TITLE_FIELD" value1="${eventTitle}" />
		<execute action="PGCalendarAddEvent#type" locator-key1="DESCRIPTION_FIELD" value1="${eventDescription}" />
		<execute action="PGCalendarAddEvent#select" locator-key1="TYPE_SELECT" value1="${eventType}" />
		<execute action="PGCalendarAddEvent#check" locator-key1="REPEAT_MONTHLY_CHECKBOX" value1="Monthly" />
		<execute action="PGCalendarAddEvent#check" locator-key1="REPEAT_END_DATE" value1="End By" />
		<execute action="PGCalendarAddEvent#select" locator-key1="END_DATE_MONTH_SELECT" value1="${eventEndMonth}" />
		<execute action="PGCalendarAddEvent#select" locator-key1="END_DATE_DAY_SELECT" value1="${eventEndDay}" />
		<execute action="PGCalendarAddEvent#select" locator-key1="END_DATE_YEAR_SELECT" value1="${eventEndYear}" />
		<execute action="PGCalendarAddEvent#assertClick" locator-key1="SAVE_BUTTON" value1="Save" />

		<execute action="PGCalendar#assertTextEquals" locator-key1="SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute action="PGCalendar#assertClick" locator-key1="VIEW_EVENTS" value1="Events" />
		<execute action="PGCalendar#assertElementPresent" locator-key1="EVENT_TABLE_TIME" />
		<execute action="PGCalendar#assertTextEquals" locator-key1="EVENT_TABLE_TITLE" value1="${eventTitle}" />
		<execute action="PGCalendar#assertTextEquals" locator-key1="EVENT_TABLE_TYPE" value1="${eventType}" />
		<execute action="PGCalendar#assertTextEquals" locator-key1="EVENT_TABLE_ACTIONS" value1="Actions" />
	</command>

	<command name="addRepeatWeeklyPG">
		<var name="key_eventTitle" value="${eventTitle}" />

		<execute action="PGCalendar#assertClick" locator-key1="ADD_EVENT_BUTTON" value1="Add Event" />

		<execute action="PGCalendarAddEvent#select" locator-key1="START_DATE_MONTH_SELECT" value1="${eventStartMonth}" />
		<execute action="PGCalendarAddEvent#select" locator-key1="START_DATE_DAY_SELECT" value1="${eventStartDay}" />
		<execute action="PGCalendarAddEvent#select" locator-key1="START_DATE_YEAR_SELECT" value1="${eventStartYear}" />
		<execute action="PGCalendarAddEvent#type" locator-key1="TITLE_FIELD" value1="${eventTitle}" />
		<execute action="PGCalendarAddEvent#type" locator-key1="DESCRIPTION_FIELD" value1="${eventDescription}" />
		<execute action="PGCalendarAddEvent#select" locator-key1="TYPE_SELECT" value1="${eventType}" />
		<execute action="PGCalendarAddEvent#check" locator-key1="REPEAT_WEEKLY_CHECKBOX" value1="Repeat Weekly Checkbox" />
		<execute action="PGCalendarAddEvent#check" locator-key1="REPEAT_SUNDAY" value1="Sunday" />
		<execute action="PGCalendarAddEvent#check" locator-key1="REPEAT_END_DATE" value1="End By" />
		<execute action="PGCalendarAddEvent#select" locator-key1="END_DATE_MONTH_SELECT" value1="${eventEndMonth}" />
		<execute action="PGCalendarAddEvent#select" locator-key1="END_DATE_DAY_SELECT" value1="${eventEndDay}" />
		<execute action="PGCalendarAddEvent#select" locator-key1="END_DATE_YEAR_SELECT" value1="${eventEndYear}" />
		<execute action="PGCalendarAddEvent#assertClick" locator-key1="SAVE_BUTTON" value1="Save" />

		<execute action="PGCalendar#assertTextEquals" locator-key1="SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute action="PGCalendar#assertClick" locator-key1="VIEW_EVENTS" value1="Events" />
		<execute action="PGCalendar#assertElementPresent" locator-key1="EVENT_TABLE_TIME" />
		<execute action="PGCalendar#assertTextEquals" locator-key1="EVENT_TABLE_TITLE" value1="${eventTitle}" />
		<execute action="PGCalendar#assertTextEquals" locator-key1="EVENT_TABLE_TYPE" value1="${eventType}" />
		<execute action="PGCalendar#assertTextEquals" locator-key1="EVENT_TABLE_ACTIONS" value1="Actions" />
	</command>

	<command name="deleteCP">
		<execute action="CPCalendar#assertClick" locator-key1="VIEW_SUMMARY" value1="Summary" />
		<execute action="CPCalendar#assertTextEquals" locator-key1="EVENT_TABLE_TITLE" value1="${eventTitle}" />
		<execute action="CPCalendar#assertClick" locator-key1="EVENT_TABLE_ACTIONS" value1="Actions" />
		<execute action="CPCalendar#assertClick" locator-key1="EVENT_MENULIST_DELETE" value1="Delete" />
		<execute action="CPCalendar#confirm" locator-key1="CONFIRMATION" value1="Are you sure you want to delete this?" />
		<execute action="CPCalendar#assertTextEquals" locator-key1="SUCCESS_MESSAGE" value1="Your request completed successfully." />
	</command>

	<command name="deletePG">
		<var name="key_eventTitle" value="${eventTitle}" />

		<execute action="PGCalendar#assertClick" locator-key1="VIEW_SUMMARY" value1="Summary" />
		<execute action="PGCalendar#assertTextEquals" locator-key1="EVENT_TABLE_TITLE" value1="${eventTitle}" />
		<execute action="PGCalendar#assertClick" locator-key1="EVENT_TABLE_ACTIONS"  value1="Actions" />
		<execute action="PGCalendar#assertClick" locator-key1="EVENT_MENULIST_DELETE" value1="Delete" />
		<execute action="PGCalendar#confirm" locator-key1="CONFIRMATION" value1="Are you sure you want to delete this?" />
		<execute action="PGCalendar#assertTextEquals" locator-key1="SUCCESS_MESSAGE" value1="Your request completed successfully." />
	</command>

	<command name="editCP">
		<execute action="CPCalendar#assertClick" locator-key1="VIEW_SUMMARY" value1="Summary" />
		<execute action="CPCalendar#assertTextEquals" locator-key1="EVENT_TABLE_TITLE" value1="${eventTitle}" />
		<execute action="CPCalendar#assertClick" locator-key1="EVENT_TABLE_ACTIONS"  value1="Actions" />
		<execute action="CPCalendar#assertClick" locator-key1="EVENT_MENULIST_EDIT" value1="Edit" />

		<execute action="CPCalendarEditEvent#type" locator-key1="TITLE_FIELD" value1="${eventTitleEdit}" />
		<execute action="CPCalendarEditEvent#assertClick" locator-key1="SAVE_BUTTON" value1="Save" />

		<execute action="CPCalendar#assertTextEquals" locator-key1="SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute action="CPCalendar#assertElementPresent" locator-key1="EVENT_TABLE_TIME" />
		<execute action="CPCalendar#assertTextEquals" locator-key1="EVENT_TABLE_TITLE" value1="${eventTitleEdit}" />
		<execute action="CPCalendar#assertTextEquals" locator-key1="EVENT_TABLE_TYPE" value1="Anniversary" />
		<execute action="CPCalendar#assertTextEquals" locator-key1="EVENT_TABLE_ACTIONS" value1="Actions" />
	</command>

	<command name="editPG">
		<var name="key_eventTitle" value="${eventTitle}" />

		<execute action="PGCalendar#assertClick" locator-key1="VIEW_SUMMARY" value1="Summary" />
		<execute action="PGCalendar#assertTextEquals" locator-key1="EVENT_TABLE_TITLE" value1="${eventTitle}" />
		<execute action="PGCalendar#assertClick" locator-key1="EVENT_TABLE_ACTIONS"  value1="Actions" />
		<execute action="PGCalendar#assertClick" locator-key1="EVENT_MENULIST_EDIT" value1="Edit" />

		<execute action="PGCalendarEditEvent#type" locator-key1="TITLE_FIELD" value1="${eventTitleEdit}" />
		<execute action="PGCalendarEditEvent#type" locator-key1="DESCRIPTION_FIELD" value1="${eventDescriptionEdit}" />
		<execute action="PGCalendarEditEvent#assertClick" locator-key1="SAVE_BUTTON" value1="Save" />

		<execute action="PGCalendar#assertTextEquals" locator-key1="SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute action="PGCalendar#assertElementPresent" locator-key1="EVENT_TABLE_TIME" />
		<execute action="PGCalendar#assertTextEquals" locator-key1="EVENT_TABLE_TITLE" value1="${eventTitleEdit}" />
		<execute action="PGCalendar#assertTextEquals" locator-key1="EVENT_TABLE_TYPE" value1="Anniversary" />
		<execute action="PGCalendar#assertTextEquals" locator-key1="EVENT_TABLE_ACTIONS" value1="Actions" />
	</command>

	<command name="tearDownCP">
		<execute macro="Page#gotoCP">
			<var name="portletName" value="Calendar" />
		</execute>

		<execute action="PGCalendar#assertClick" locator-key1="VIEW_EVENTS" value1="Events" />

		<while>
			<condition action="CPCalendarEvents#isElementPresent" locator-key1="EVENT_TABLE_ACTIONS" value1="Actions" />
			<then>
				<execute action="CPCalendarEvents#assertClick" locator-key1="EVENT_TABLE_ACTIONS"  value1="Actions" />
				<execute action="CPCalendarEvents#assertClick" locator-key1="EVENT_MENULIST_DELETE" value1="Delete" />
				<execute action="CPCalendarEvents#confirm" locator-key1="CONFIRMATION" value1="Are you sure you want to delete this?" />
				<execute action="CPCalendarEvents#assertTextEquals" locator-key1="SUCCESS_MESSAGE" value1="Your request completed successfully." />
			</then>
		</while>

		<execute action="CPCalendarEvents#assertElementNotPresent" locator-key1="EVENT_TABLE_ACTIONS" value1="Actions" />
	</command>

	<command name="viewPG">
		<var name="key_eventTitle" value="${eventTitle}" />

		<execute action="PGCalendar#assertClick" locator-key1="EVENT_TABLE_TITLE" value1="${eventTitle}" />

		<execute macro="Event#viewDetailsPG" />
	</command>

	<command name="viewDetailsPG">
		<if>
			<isset var="number" />
			<then>
				<var name="number" value="${number}" />
				<execute action="PGCalendarEventDetails#assertTextEquals" locator-key1="EVENT_TITLE" value1="${eventTitle}${number}" />
			</then>
			<else>
				<execute action="PGCalendarEventDetails#assertTextEquals" locator-key1="EVENT_TITLE" value1="${eventTitle}" />
			</else>
		</if>

		<execute action="PGCalendarEventDetails#assertTextEquals" locator-key1="START_DATE" value1="Start Date:" />
		<execute action="PGCalendarEventDetails#assertTextEquals" locator-key1="END_DATE" value1="End Date:" />
		<execute action="PGCalendarEventDetails#assertTextEquals" locator-key1="DURATION" value1="Duration:" />
		<execute action="PGCalendarEventDetails#assertTextEquals" locator-key1="TYPE" value1="Type:" />

		<if>
			<isset var="number" />
			<then>
				<var name="number" value="${number}" />
				<execute action="PGCalendarEventDetails#assertTextEquals" locator-key1="EVENT_DESCRIPTION" value1="${eventDescription}${number}" />
			</then>
			<else>
				<execute action="PGCalendarEventDetails#assertTextEquals" locator-key1="EVENT_DESCRIPTION" value1="${eventDescription}" />
			</else>
		</if>

		<execute action="PGCalendarEventDetails#assertTextEquals" locator-key1="YOUR_RATING" value1="Your Rating" />
		<execute action="PGCalendarEventDetails#assertTextEquals" locator-key1="AVERAGE" value1="Average (0 Votes)" />
		<execute action="PGCalendarEventDetails#assertTextEquals" locator-key1="NO_COMMENTS_YET" value1="No comments yet. Be the first. Subscribe to Comments" />
		<execute action="PGCalendarEventDetails#assertTextEquals" locator-key1="BE_THE_FIRST_LINK" value1="Be the first." />
		<execute action="PGCalendarEventDetails#assertTextEquals" locator-key1="SUBSCRIBE_TO_COMMENTS_LINK" value1="Subscribe to Comments" />
	</command>
</definition>