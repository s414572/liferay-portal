<definition>
	<command name="addSOSite">
		<execute action="SOUserBar#click" locator-key1="DASHBOARD" />
		<execute action="SOUserBar#click" locator-key1="GO_TO" />
		<execute action="SOUserBar#click" locator-key1="GO_TO_ADD_SITE_BUTTON" />

		<execute action="SOUserBarAddSite#type" locator-key1="NAME_FIELD" value1="${siteName}" />
		<execute action="SOUserBarAddSite#type" locator-key1="DESCRIPTION_FIELD" value1="${siteDescription}" />
		<execute action="SOUserBarAddSite#click" locator-key1="NEXT_BUTTON" />
		<execute action="SOUserBarAddSite#select" locator-key1="DEFAULT_PAGES_SELECT" value1="Default Social Office Site" />

		<execute action="SOUserBarAddSite#check" locator-key1="HOME_CHECKBOX" />
		<execute action="SOUserBarAddSite#check" locator-key1="CALENDAR_CHECKBOX" />
		<execute action="SOUserBarAddSite#check" locator-key1="DOCUMENTS_CHECKBOX" />
		<execute action="SOUserBarAddSite#check" locator-key1="FORUMS_CHECKBOX" />
		<execute action="SOUserBarAddSite#check" locator-key1="BLOGS_CHECKBOX" />
		<execute action="SOUserBarAddSite#check" locator-key1="WIKI_CHECKBOX" />
		<execute action="SOUserBarAddSite#check" locator-key1="MEMBERS_CHECKBOX" />

		<if>
			<equals arg1="${siteType}" arg2="Private" />
			<then>
				<execute action="SOUserBarAddSite#select" locator-key1="TYPE_SELECT" value1="value=3" />
				<execute action="SOUserBarAddSite#assertSelectedLabel" locator-key1="TYPE_SELECT" value1="Private" />
			</then>
			<else>
				<execute action="SOUserBarAddSite#select" locator-key1="TYPE_SELECT" value1="${siteType}" />
			</else>
		</if>

		<execute action="SOUserBarAddSite#click" locator-key1="SAVE_BUTTON" />
		<execute action="SOUserBarAddSite#assertElementNotPresent" locator-key1="SAVE_BUTTON" />
	</command>

	<command name="dashboardPG">
		<execute action="SOUserBar#click" locator-key1="DASHBOARD" />

		<execute action="SODashboard#assertTextEquals" locator-key1="PROFILE_NAME" value1="${userName}" />
	</command>

	<command name="deleteSOSite">
		<execute action="SOUserBar#click" locator-key1="DASHBOARD" />
		<execute action="SOUserBar#click" locator-key1="GO_TO" />
		<execute action="SOUserBar#click" locator-key1="GO_TO_SITES_DIRECTORY_BUTTON" />

		<if>
			<equals arg1="${siteType}" arg2="Private" />
			<then>
				<execute action="SOUserBar#click" locator-key1="GO_TO" />
				<execute action="SOUserBar#select" locator-key1="GO_TO_SITE_CATEGORY_SELECT" value1="My Sites" />
			</then>
			<else>
				<execute action="SOUserBar#click" locator-key1="GO_TO" />
				<execute action="SOUserBar#select" locator-key1="GO_TO_SITE_CATEGORY_SELECT" value1="All Sites" />
			</else>
		</if>

		<execute action="SOUserBarSitesDirectory#type" locator-key1="SITE_SEARCH_FIELD" value1="${siteName}" />
		<execute action="SOUserBarSitesDirectory#assertTextEquals" locator-key1="SITE_NAME_LINK" value1="${siteName}" />
		<execute action="SOUserBarSitesDirectory#click" locator-key1="DELETE_SITE_ICON" value1="Delete" />
		<execute action="SOUserBarSitesDirectory#confirm" locator-key1="CONFIRMATION" value1="Are you sure you want to delete ${siteName}?" />
		<execute action="SOUserBarSitesDirectory#assertTextNotPresent" value1="${siteName}" />
	</command>

	<command name="gotoCP">
		<execute action="Home#open" locator-key1="GUEST_URL" />

		<execute action="SOUserBar#click" locator-key1="USER_NAME" />
		<execute action="SOUserBar#click" locator-key1="USER_MENU_CONTROL_PANEL" value1="Control Panel"/>

		<if>
			<isset var="siteScopeName" />
			<then>
				<execute action="Home#click" locator-key1="SCOPE_SELECTOR" />

				<var name="key_siteScopeName" value="${siteScopeName}" />

				<execute action="Home#click" locator-key1="SCOPE_SELECTOR_MENULIST_ITEM" />
			</then>
		</if>

		<if>
			<equals arg1="${portletName}" arg2="Workflow" />
			<then>
				<execute action="Home#click" locator1="xPath=(//ul[@class='category-portlets']/li/a[contains(.,'${portletName}')])[3]" />
			</then>
			<else>
				<execute action="Home#click" locator1="//ul[@class='category-portlets']/li/a[contains(.,'${portletName}')]" />
			</else>
		</if>
	</command>

	<command name="gotoProfile">
		<execute macro="SOUserBar#dashboardPG">
			<var name="userName" value="${userName}" />
		</execute>

		<execute action="SOUserBar#click" locator-key1="USER_NAME" />
		<execute action="SOUserBar#click" locator-key1="USER_MENU_MY_PROFILE" value1="My Profile" />
	</command>

	<command name="myProfilePG">
		<execute action="SOUserBar#click" locator-key1="USER_NAME" />
		<execute action="SOUserBar#click" locator-key1="USER_MENU_MY_PROFILE" value1="My Profile"/>

		<execute action="SOProfile#assertTextEquals" locator-key1="USER_NAME" value1="${userName}" />
	</command>

	<command name="searchSOSite">
		<execute action="SOUserBar#click" locator-key1="DASHBOARD" />
		<execute action="SOUserBar#click" locator-key1="GO_TO" />

		<if>
			<equals arg1="${siteType}" arg2="Private" />
			<then>
				<execute action="SOUserBar#select" locator-key1="GO_TO_SITE_CATEGORY_SELECT" value1="My Sites" />
			</then>
			<else>
				<execute action="SOUserBar#select" locator-key1="GO_TO_SITE_CATEGORY_SELECT" value1="All Sites" />
			</else>
		</if>

		<execute action="SOUserBar#click" locator-key1="GO_TO" />
		<execute action="SOUserBar#type" locator-key1="GO_TO_SEARCH_FIELD" value1="${siteName}" />
		<execute action="SOUserBar#assertTextEquals" locator-key1="GO_TO_SITE_NAME_LINK" value1="${siteName}" />
	</command>

	<command name="tearDownNotifications">
		<execute macro="SOUserBar#dashboardPG">
			<var name="userName" value="${userName}" />
		</execute>

		<execute action="SOUserBar#mouseOver" locator-key1="NOTIFICATION" />
		<execute action="SOUserBar#click" locator-key1="NOTIFICATION_MENU_VIEW_ALL" value1="View All" />

		<while>
			<condition action="SONotifications#isElementPresent" locator-key1="NOTIFICATIONS_CHECKBOX" />
			<then>
				<execute action="SONotifications#check" locator-key1="NOTIFICATIONS_CHECKBOX" />
				<execute action="SONotifications#click" locator-key1="DELETE_BUTTON" />
			</then>
		</while>
	</command>

	<command name="tearDownSites">
		<execute macro="SOUserBar#gotoCP">
			<var name="portletName" value="Sites" />
		</execute>

		<execute action="CPSites#type" locator-key1="SEARCH_FIELD" value1="Name" />
		<execute action="CPSites#assertClick" locator-key1="SEARCH_BUTTON" value1="Search" />

		<while>
			<condition action="CPSites#isElementPresent" locator-key1="SITE_TABLE_ACTIONS" />
			<then>
				<execute action="CPSites#assertClick" locator-key1="SITE_TABLE_ACTIONS" value1="Actions" />
				<execute action="CPSites#assertClick" locator-key1="SITE_MENULIST_DELETE" value1="Delete" />
				<execute action="CPSites#confirm" locator-key1="CONFIRMATION" value1="Are you sure you want to delete this?" />
			</then>
		</while>
	</command>

	<command name="viewSOSite">
		<execute macro="SOUserBar#searchSOSite" />

		<execute action="SOUserBar#click" locator-key1="GO_TO_SITE_NAME_LINK" />

		<execute action="SOSiteHome#assertTextEquals" locator-key1="SITE_NAME" value1="${siteName}" />
		<execute action="SOSiteHome#assertTextEquals" locator-key1="NAVIGATION_HOME" value1="Home" />
		<execute action="SOSiteHome#assertTextEquals" locator-key1="NAVIGATION_CALENDAR" value1="Calendar" />
		<execute action="SOSiteHome#assertTextEquals" locator-key1="NAVIGATION_DOCUMENTS" value1="Documents" />
		<execute action="SOSiteHome#assertTextEquals" locator-key1="NAVIGATION_FORUMS" value1="Forums" />
		<execute action="SOSiteHome#assertTextEquals" locator-key1="NAVIGATION_BLOGS" value1="Blogs" />
		<execute action="SOSiteHome#assertTextEquals" locator-key1="NAVIGATION_WIKI" value1="Wiki" />
		<execute action="SOSiteHome#assertTextEquals" locator-key1="NAVIGATION_MEMBERS" value1="Members" />

		<execute action="SOUserBar#click" locator-key1="DASHBOARD" />
		<execute action="SOUserBar#click" locator-key1="GO_TO" />
		<execute action="SOUserBar#click" locator-key1="GO_TO_SITES_DIRECTORY_BUTTON" />

		<if>
			<equals arg1="${siteType}" arg2="Private" />
			<then>
				<execute action="SOUserBar#select" locator-key1="GO_TO_SITE_CATEGORY_SELECT" value1="My Sites" />
			</then>
			<else>
				<execute action="SOUserBar#select" locator-key1="GO_TO_SITE_CATEGORY_SELECT" value1="All Sites" />
			</else>
		</if>

		<execute action="SOUserBarSitesDirectory#type" locator-key1="SITE_SEARCH_FIELD" value1="${siteName}" />
		<execute action="SOUserBarSitesDirectory#assertTextEquals" locator-key1="SITE_NAME_LINK" value1="${siteName}" />
		<execute action="SOUserBarSitesDirectory#assertTextEquals" locator-key1="SITE_DESCRIPTION" value1="${siteDescription}" />
		<execute action="SOUserBarSitesDirectory#click" locator-key1="SITE_NAME_LINK" value1="${siteName}" />

		<execute action="SOSiteHome#assertTextEquals" locator-key1="SITE_NAME" value1="${siteName}" />
		<execute action="SOSiteHome#assertTextEquals" locator-key1="NAVIGATION_HOME" value1="Home" />
		<execute action="SOSiteHome#assertTextEquals" locator-key1="NAVIGATION_CALENDAR" value1="Calendar" />
		<execute action="SOSiteHome#assertTextEquals" locator-key1="NAVIGATION_DOCUMENTS" value1="Documents" />
		<execute action="SOSiteHome#assertTextEquals" locator-key1="NAVIGATION_FORUMS" value1="Forums" />
		<execute action="SOSiteHome#assertTextEquals" locator-key1="NAVIGATION_BLOGS" value1="Blogs" />
		<execute action="SOSiteHome#assertTextEquals" locator-key1="NAVIGATION_WIKI" value1="Wiki" />
		<execute action="SOSiteHome#assertTextEquals" locator-key1="NAVIGATION_MEMBERS" value1="Members" />

		<execute macro="SOUserBar#gotoCP">
			<var name="portletName" value="Sites" />
		</execute>

		<execute action="CPSites#type" locator-key1="SEARCH_FIELD" value1="${siteName}" />
		<execute action="CPSites#click" locator-key1="SEARCH_BUTTON" />
		<execute action="CPSites#assertTextEquals" locator-key1="SITE_TABLE_NAME" value1="${siteName}" />
		<execute action="CPSites#click" locator-key1="SITE_TABLE_NAME" />

		<if>
			<equals arg1="${siteType}" arg2="Private" />
			<then>
				<execute action="CPSitesEdit#assertChecked" locator-key1="PRIVATE_PAGE_PROPAGATION_CHECKBOX" />
			</then>
			<elseif>
				<equals arg1="${siteType}" arg2="Private Restricted" />
				<then>
					<execute action="CPSitesEdit#assertChecked" locator-key1="PRIVATE_PAGE_PROPAGATION_CHECKBOX" />
				</then>
			</elseif>
			<else>
				<execute action="CPSitesEdit#assertChecked" locator-key1="PUBLIC_PAGE_PROPAGATION_CHECKBOX" />
			</else>
		</if>

		<execute action="CPSitesEdit#assertSelectedLabel" locator-key1="APPLICATION_ADAPTER_SELECT" value1="Social Office EE Hook" />
	</command>
</definition>