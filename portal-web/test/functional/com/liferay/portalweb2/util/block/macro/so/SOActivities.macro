<definition>
	<command name="addSiteContent">
		<execute macro="Page#gotoPG">
			<var name="pageName" value="Calendar" />
			<var name="pageType" value="Open Site" />
		</execute>

		<execute macro="Event#addPG">
			<var name="eventDescription" value="${eventDescription}" />
			<var name="eventTitle" value="${eventTitle}" />
		</execute>

		<execute macro="SONavigation#gotoSiteDocuments">
			<var name="pageType" value="Open Site" />
		</execute>

		<execute macro="DMFolder#addPG">
			<var name="dmFolderName" value="${dmFolderName}" />
			<var name="dmFolderDescription" value="${dmFolderDescription}" />
			<var name="pageType" value="Open Site" />
		</execute>

		<execute macro="SONavigation#gotoSiteDocuments">
			<var name="pageType" value="Open Site" />
		</execute>

		<execute macro="DMFolderDocument#addPG">
			<var name="dmDocumentDescription" value="${dmDocumentDescription}" />
			<var name="dmDocumentFile" value="${dmDocumentFile}" />
			<var name="dmDocumentTitle" value="${dmDocumentTitle}" />
			<var name="dmFolderName" value="${dmFolderName2}" />
			<var name="dmFolderName" value="${dmFolderName}" />
		</execute>

		<execute macro="Page#gotoPG">
			<var name="pageName" value="Forums" />
			<var name="pageType" value="Open Site" />
		</execute>

		<execute macro="MessageboardsCategory#addPG">
			<var name="categoryName" value="${categoryName}" />
		</execute>

		<execute macro="Page#gotoPG">
			<var name="pageName" value="Forums" />
			<var name="pageType" value="Open Site" />
		</execute>

		<execute macro="MessageboardsCategory#gotoPG">
			<var name="categoryName" value="${categoryName}" />
		</execute>

		<execute macro="MessageboardsThread#addPG" />

		<execute macro="Page#gotoPG">
			<var name="pageName" value="Blogs" />
			<var name="pageType" value="Open Site" />
		</execute>

		<execute macro="BlogsEntry#addPG" />

		<execute macro="Page#gotoPG">
			<var name="pageName" value="Wiki" />
			<var name="pageType" value="Open Site" />
		</execute>

		<if>
			<not>
				<isset var="wikiEditOnly" />
			</not>
			<then>
				<execute macro="WikiPage#addFrontPagePG">
					<var name="pageName" value="Wiki" />
					<var name="wikiPageContent" value="${wikiPageContent}" />
				</execute>
			</then>
		</if>

		<execute macro="WikiPage#editFrontPagePG">
			<var name="pageName" value="Wiki" />
			<var name="pageType" value="Open Site" />
			<var name="wikiPageContentEdit" value="${wikiPageContentEdit}" />
		</execute>

		<execute macro="Page#openURL">
			<var name="pageType" value="Open Site" />
		</execute>

		<execute macro="SOBookmarks#addBookmarksEntry">
			<var name="bookmarksEntryDescription" value="${bookmarksEntryDescription}" />
			<var name="bookmarksEntryName" value="${bookmarksEntryName}" />
			<var name="bookmarksEntryUrl" value="${bookmarksEntryUrl}" />
		</execute>
	</command>

	<command name="viewBlogsActivityEntry">
		<if>
			<isset var="row" />
			<then>
				<var name="row" value="${row}" />
			</then>
			<else>
				<var name="row" value="01" />
			</else>
		</if>

		<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_USER" value1="${userName}" />
		<execute action="SOActivities#assertElementPresent" locator-key1="ACTIVITIES_TIME_STAMP" />
		<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_ACTION" value1="${action}" />

		<if>
			<isset var="number" />
			<then>
				<var name="number" value="${number}" />

				<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_TITLE" value1="${entryTitle}${number}" />
				<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_CONTENT" value1="${entryContent}${number}" />
			</then>
			<else>
				<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_TITLE" value1="${entryTitle}" />
				<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_CONTENT" value1="${entryContent}" />
			</else>
		</if>

		<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_COMMENT" value1="Comment" />
		<execute action="SOActivities#assertElementPresent" locator-key1="ACTIVITIES_COMMENT_FIELD" />
	</command>

	<command name="viewBookmarksActivityEntry">
		<if>
			<isset var="row" />
			<then>
				<var name="row" value="${row}" />
			</then>
			<else>
				<var name="row" value="01" />
			</else>
		</if>

		<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_USER" value1="${userName}" />
		<execute action="SOActivities#assertElementPresent" locator-key1="ACTIVITIES_TIME_STAMP" />
		<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_ACTION" value1="${action}" />

		<if>
			<isset var="number" />
			<then>
				<var name="number" value="${number}" />

				<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_TITLE" value1="${bookmarksEntryName}${number}" />
				<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_CONTENT" value1="${bookmarksEntryDescription}${number}" />
			</then>
			<else>
				<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_TITLE" value1="${bookmarksEntryName}" />
				<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_CONTENT" value1="${bookmarksEntryDescription}" />
			</else>
		</if>

		<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_COMMENT" value1="Comment" />
		<execute action="SOActivities#assertElementPresent" locator-key1="ACTIVITIES_COMMENT_FIELD" />
	</command>

	<command name="viewCalendarActivityEntry">
		<if>
			<isset var="row" />
			<then>
				<var name="row" value="${row}" />
			</then>
			<else>
				<var name="row" value="01" />
			</else>
		</if>

		<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_USER" value1="${userName}" />
		<execute action="SOActivities#assertElementPresent" locator-key1="ACTIVITIES_TIME_STAMP" />
		<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_ACTION" value1="${action}" />
		<execute action="SOActivities#assertElementPresent" locator-key1="ACTIVITIES_EVENT_DATE" />

		<if>
			<isset var="number" />
			<then>
				<var name="number" value="${number}" />

				<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_EVENT_DESCRIPTION" value1="Description: ${eventDescription}${number}" />
			</then>
			<else>
				<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_EVENT_DESCRIPTION" value1="Description: ${eventDescription}" />
			</else>
		</if>

		<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_COMMENT" value1="Comment" />
		<execute action="SOActivities#assertElementPresent" locator-key1="ACTIVITIES_COMMENT_FIELD" />
	</command>

	<command name="viewDocumentsActivityEntry">
		<if>
			<isset var="row" />
			<then>
				<var name="row" value="${row}" />
			</then>
			<else>
				<var name="row" value="01" />
			</else>
		</if>

		<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_USER" value1="${userName}" />
		<execute action="SOActivities#assertElementPresent" locator-key1="ACTIVITIES_TIME_STAMP" />
		<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_ACTION" value1="${action}" />

		<if>
			<isset var="number" />
			<then>
				<var name="number" value="${number}" />

				<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_TITLE" value1="${dmDocumentTitle}${number}" />
				<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_DOCUMENT_VERSION" value1="Version ${dmDocumentVersionNumber}" />
				<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_DOCUMENT_DESCRIPTION" value1="${dmDocumentDescription}${number}" />
			</then>
			<else>
				<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_TITLE" value1="${dmDocumentTitle}" />
				<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_DOCUMENT_VERSION" value1="Version ${dmDocumentVersionNumber}" />
				<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_DOCUMENT_DESCRIPTION" value1="${dmDocumentDescription}" />
			</else>
		</if>

		<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_DOWNLOAD" value1="Download" />
		<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_COMMENT" value1="Comment" />
		<execute action="SOActivities#assertElementPresent" locator-key1="ACTIVITIES_COMMENT_FIELD" />
	</command>

	<command name="viewForumsActivityEntry">
		<if>
			<isset var="row" />
			<then>
				<var name="row" value="${row}" />
			</then>
			<else>
				<var name="row" value="01" />
			</else>
		</if>

		<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_USER" value1="${userName}" />
		<execute action="SOActivities#assertElementPresent" locator-key1="ACTIVITIES_TIME_STAMP" />
		<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_ACTION" value1="${action}" />

		<if>
			<isset var="number" />
			<then>
				<var name="number" value="${number}" />

				<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_TITLE" value1="${threadSubject}${number}" />
				<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_CONTENT" value1="${threadBody}${number}" />
			</then>
			<else>
				<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_TITLE" value1="${threadSubject}" />
				<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_CONTENT" value1="${threadBody}" />
			</else>
		</if>

	</command>

	<command name="viewMicroblogsActivityEntry">
		<if>
			<isset var="row" />
			<then>
				<var name="row" value="${row}" />
			</then>
			<else>
				<var name="row" value="01" />
			</else>
		</if>

		<execute action="SOActivities#assertElementPresent" locator-key1="NO_ACTIVITIES" />

		<if>
			<condition action="SOActivities#isElementPresent" locator-key1="ACTIVITIES_USER_LINK" />
			<then>
				<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_USER" value1="${userName}" />
			</then>
			<else>
				<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_USER" value1="${userFirstName}" />
			</else>
		</if>

		<execute action="SOActivities#assertElementPresent" locator-key1="ACTIVITIES_TIME_STAMP" />
		<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_ACTION" value1="${microblogsEntryContent}" />
		<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_VIEW_MICROBLOGS" value1="View Microblogs" />

		<if>
			<condition action="SOActivities#isElementPresent" locator-key1="ACTIVITIES_USER_LINK" />
			<then>
				<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_REPOST" value1="Repost" />
			</then>
		</if>

		<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_COMMENT" value1="Comment" />
		<execute action="SOActivities#assertElementPresent" locator-key1="ACTIVITIES_COMMENT_FIELD" />
	</command>

	<command name="viewMicroblogsActivityEntryProfile">
		<if>
			<isset var="number" />
			<then>
				<var name="number" value="${number}" />
			</then>
			<else>
				<var name="number" value="01" />
			</else>
		</if>

		<execute action="SOUserBar#click" locator-key1="USER_NAME" />
		<execute action="SOUserBar#click" locator-key1="USER_MENU_MY_ACCOUNT" value1="My Account" />

		<var name="currentUser" path="CPMyAccount" locator-key="USER_NAME_HEADER" />

		<if>
			<isset var="profileScreenName" />
			<then>
				<execute action="SOProfile#open" locator-key1="PROFILE_URL" />
			</then>
			<else>
				<execute action="SOUserBar#click" locator-key1="USER_NAME" />
				<execute action="SOUserBar#click" locator-key1="USER_MENU_MY_PROFILE" value1="My Profile"/>
			</else>
		</if>

		<execute action="SOActivities#assertElementPresent" locator-key1="NO_ACTIVITIES" />

		<if>
			<isset var="microblogsEntryAuthorMiddleName" />
			<then>
				<if>
					<equals arg1="${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorMiddleName} ${microblogsEntryAuthorLastName}" arg2="${currentUser}" />
					<then>
						<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_USER" value1="${microblogsEntryAuthorFirstName}" />
					</then>
					<else>
						<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_USER" value1="${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorMiddleName} ${microblogsEntryAuthorLastName}" />
					</else>
				</if>
			</then>
			<else>
				<if>
					<equals arg1="${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorLastName}" arg2="${currentUser}" />
					<then>
						<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_USER" value1="${microblogsEntryAuthorFirstName}" />
					</then>
					<else>
						<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_USER" value1="${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorLastName}" />
					</else>
				</if>	
			</else>
		</if>

		<execute action="SOActivities#assertElementPresent" locator-key1="ACTIVITIES_TIME_STAMP" />
		<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_ACTION" value1="${microblogsEntryContent}" />
		<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_VIEW_MICROBLOGS" value1="View Microblogs" />

		<if>
			<condition action="SOActivities#isElementPresent" locator-key1="ACTIVITIES_USER_LINK" />
			<then>
				<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_REPOST" value1="Repost" />
			</then>
		</if>

		<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_COMMENT" value1="Comment" />
		<execute action="SOActivities#assertElementPresent" locator-key1="ACTIVITIES_COMMENT_FIELD" />
	</command>

	<command name="viewMicroblogsCommentActivityEntry">
		<if>
			<isset var="number" />
			<then>
				<var name="number" value="${number}" />
			</then>
			<else>
				<var name="number" value="01" />
			</else>
		</if>

		<execute action="SOActivities#assertElementPresent" locator-key1="NO_ACTIVITIES" />

		<if>
			<condition action="SOActivities#isElementPresent" locator-key1="ACTIVITIES_USER_LINK" />
			<then>
				<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_USER" value1="${userName}" />
			</then>
			<else>
				<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_USER" value1="${userFirstName}" />
			</else>
		</if>

		<execute action="SOActivities#assertElementPresent" locator-key1="ACTIVITIES_TIME_STAMP" />
		<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_ACTION" value1="Commented on a microblog entry." />
		<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_CONTENT" value1="${microblogsEntryContent}" />
		<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_VIEW_MICROBLOGS" value1="View Microblogs" />

		<if>
			<condition action="SOActivities#isElementPresent" locator-key1="ACTIVITIES_USER_LINK" />
			<then>
				<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_REPOST" value1="Repost" />
			</then>
		</if>

		<if>
			<equals arg1="${commentCount}" arg2="1" />
			<then>
				<execute action="SOActivities#assertClick" locator-key1="ACTIVITIES_COMMENT" value1="1 Comment" />
			</then>
			<else>
				<execute action="SOActivities#assertClick" locator-key1="ACTIVITIES_COMMENT" value1="${commentCount} Comments" />
			</else>
		</if>

		<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_COMMENT_USER_NAME" value1="${userName}" />
		<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_COMMENT_CONTENT" value1="${microblogsEntryCommentContent}" />

		<execute action="SOActivities#assertElementPresent" locator-key1="ACTIVITIES_COMMENT_FIELD" />
	</command>

	<command name="viewMicroblogsNotViewableByEveryoneActivityEntry">
		<if>
			<isset var="number" />
			<then>
				<var name="number" value="${number}" />
			</then>
			<else>
				<var name="number" value="01" />
			</else>
		</if>

		<execute action="SOActivities#assertElementPresent" locator-key1="NO_ACTIVITIES" />

		<if>
			<condition action="SOActivities#isElementPresent" locator-key1="ACTIVITIES_USER_LINK" />
			<then>
				<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_USER" value1="${userName}" />
			</then>
			<else>
				<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_USER" value1="${userFirstName}" />
			</else>
		</if>

		<execute action="SOActivities#assertElementPresent" locator-key1="ACTIVITIES_TIME_STAMP" />
		<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_ACTION" value1="${microblogsEntryContent}" />
		<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_VIEW_MICROBLOGS" value1="View Microblogs" />
		<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_COMMENT" value1="Comment" />
		<execute action="SOActivities#assertElementPresent" locator-key1="ACTIVITIES_COMMENT_FIELD" />
	</command>

	<command name="viewMicroblogsRepostActivityEntry">
		<if>
			<isset var="number" />
			<then>
				<var name="number" value="${number}" />
			</then>
			<else>
				<var name="number" value="01" />
			</else>
		</if>

		<execute action="SOUserBar#click" locator-key1="USER_NAME" />
		<execute action="SOUserBar#click" locator-key1="USER_MENU_MY_ACCOUNT" value1="My Account" />

		<var name="currentUser" path="CPMyAccount" locator-key="USER_NAME_HEADER" />
	
		<execute action="SOUserBar#click" locator-key1="DASHBOARD" />

		<execute action="SOActivities#assertElementPresent" locator-key1="NO_ACTIVITIES" />

		<if>
			<condition action="SOActivities#isElementPresent" locator-key1="ACTIVITIES_USER_LINK" />
			<then>
				<if>
					<isset var="microblogsEntryRepostAuthorMiddleName" />
					<then>
						<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_USER" value1="${microblogsEntryRepostAuthorFirstName} ${microblogsEntryRepostAuthorMiddleName} ${microblogsEntryRepostAuthorLastName}" />
					</then>
					<else>
						<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_USER" value1="${microblogsEntryRepostAuthorFirstName} ${microblogsEntryRepostAuthorLastName}" />
					</else>
				</if>
			</then>
			<else>
				<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_USER" value1="${microblogsEntryRepostAuthorFirstName}" />
			</else>
		</if>

		<execute action="SOActivities#assertElementPresent" locator-key1="ACTIVITIES_TIME_STAMP" />

		<if>
			<isset var="microblogsEntryRepostAuthorMiddleName" />
			<then>
				<if>
					<equals arg1="${microblogsEntryRepostAuthorFirstName} ${microblogsEntryRepostAuthorMiddleName} ${microblogsEntryRepostAuthorLastName}" arg2="${currentUser}" />
					<then>
						<if>
							<isset var="microblogsEntryAuthorMiddleName" />
							<then>
								<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_ACTION" value1="Reposted a microblog entry from ${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorMiddleName} ${microblogsEntryAuthorLastName}." />
							</then>
							<else>
								<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_ACTION" value1="Reposted a microblog entry from ${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorLastName}." />			
							</else>
						</if>
					</then>
					<else>
						<if>
							<isset var="microblogsEntryAuthorMiddleName" />
							<then>
								<if>
									<equals arg1="${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorMiddleName} ${microblogsEntryAuthorLastName}" arg2="${currentUser}" />
									<then>
										<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_ACTION" value1="${microblogsEntryRepostAuthorFirstName} ${microblogsEntryRepostAuthorMiddleName} ${microblogsEntryRepostAuthorLastName} Reposted a microblog entry from ${microblogsEntryAuthorFirstName}." />
									</then>
									<else>
										<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_ACTION" value1="${microblogsEntryRepostAuthorFirstName} ${microblogsEntryRepostAuthorMiddleName} ${microblogsEntryRepostAuthorLastName} Reposted a microblog entry from ${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorMiddleName} ${microblogsEntryAuthorLastName}." />
									</else>
								</if>
							</then>
							<else>
								<if>
									<equals arg1="${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorLastName}" arg2="${currentUser}" />
									<then>
										<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_ACTION" value1="${microblogsEntryRepostAuthorFirstName} ${microblogsEntryRepostAuthorMiddleName} ${microblogsEntryRepostAuthorLastName} Reposted a microblog entry from ${microblogsEntryAuthorFirstName}." />
									</then>
									<else>
										<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_ACTION" value1="${microblogsEntryRepostAuthorFirstName} ${microblogsEntryRepostAuthorMiddleName} ${microblogsEntryRepostAuthorLastName} Reposted a microblog entry from ${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorLastName}." />
									</else>
								</if>
							</else>
						</if>
					</else>
				</if>
			</then>
			<else>
				<if>
					<equals arg1="${microblogsEntryRepostAuthorFirstName} ${microblogsEntryRepostAuthorLastName}" arg2="${currentUser}" />
					<then>
						<if>
							<isset var="microblogsEntryAuthorMiddleName" />
							<then>
								<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_ACTION" value1="Reposted a microblog entry from ${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorMiddleName} ${microblogsEntryAuthorLastName}." />
							</then>
							<else>
								<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_ACTION" value1="Reposted a microblog entry from ${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorLastName}." />			
							</else>
						</if>
					</then>
					<else>
						<if>
							<isset var="microblogsEntryAuthorMiddleName" />
							<then>
								<if>
									<equals arg1="${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorMiddleName} ${microblogsEntryAuthorLastName}" arg2="${currentUser}" />
									<then>
										<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_ACTION" value1="${microblogsEntryRepostAuthorFirstName} ${microblogsEntryRepostAuthorLastName} Reposted a microblog entry from ${microblogsEntryAuthorFirstName}." />
									</then>
									<else>
										<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_ACTION" value1="${microblogsEntryRepostAuthorFirstName} ${microblogsEntryRepostAuthorLastName} Reposted a microblog entry from ${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorMiddleName} ${microblogsEntryAuthorLastName}." />
									</else>
								</if>
							</then>
							<else>
								<if>
									<equals arg1="${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorLastName}" arg2="${currentUser}" />
									<then>
										<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_ACTION" value1="${microblogsEntryRepostAuthorFirstName} ${microblogsEntryRepostAuthorLastName} Reposted a microblog entry from ${microblogsEntryAuthorFirstName}." />
									</then>
									<else>
										<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_ACTION" value1="${microblogsEntryRepostAuthorFirstName} ${microblogsEntryRepostAuthorLastName} Reposted a microblog entry from ${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorLastName}." />
									</else>
								</if>
							</else>
						</if>
					</else>
				</if>
			</else>
		</if>

		<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_CONTENT" value1="${microblogsEntryContent}" />
		<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_VIEW_MICROBLOGS" value1="View Microblogs" />

		<if>
			<condition action="SOActivities#isElementPresent" locator-key1="ACTIVITIES_USER_LINK" />
			<then>
				<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_REPOST" value1="Repost" />
			</then>
		</if>

		<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_COMMENT" value1="Comment" />
		<execute action="SOActivities#assertElementPresent" locator-key1="ACTIVITIES_COMMENT_FIELD" />
	</command>

	<command name="viewMicroblogsRepostActivityEntryProfile">
		<if>
			<isset var="number" />
			<then>
				<var name="number" value="${number}" />
			</then>
			<else>
				<var name="number" value="01" />
			</else>
		</if>

		<execute action="SOUserBar#click" locator-key1="USER_NAME" />
		<execute action="SOUserBar#click" locator-key1="USER_MENU_MY_ACCOUNT" value1="My Account" />

		<var name="currentUser" path="CPMyAccount" locator-key="USER_NAME_HEADER" />

		<if>
			<isset var="profileScreenName" />
			<then>
				<execute action="SOProfile#open" locator-key1="PROFILE_URL" />
			</then>
			<else>
				<execute action="SOUserBar#click" locator-key1="USER_NAME" />
				<execute action="SOUserBar#click" locator-key1="USER_MENU_MY_PROFILE" value1="My Profile"/>
			</else>
		</if>

		<execute action="SOActivities#assertElementPresent" locator-key1="NO_ACTIVITIES" />

		<if>
			<isset var="microblogsEntryRepostAuthorMiddleName" />
