						<if>
							<equals arg1="${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorLastName}" arg2="${currentUser}" />
							<then>
								<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_ACTION" value1="Reposted a microblog entry from ${microblogsEntryAuthorFirstName}." />
							</then>
							<else>
								<execute action="SOActivities#assertTextEquals" locator-key1="ACTIVITIES_ACTION" value1="Reposted a microblog entry from ${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorLastName}." />	
							</else>
						</if>
					</else>
				</if>
			</then>
			<else>
				<if>
					<isset var="microblogsEntryRepostAuthorMiddleName" />
					<then>
						<if>
							<equals arg1="${microblogsEntryRepostAuthorFirstName} ${microblogsEntryRepostAuthorMiddleName} ${microblogsEntryRepostAuthorLastName}" arg2="${currentUser}" />
							<then>
								<if>
									<isset var="microblogsEntryAuthorMiddleName" />
