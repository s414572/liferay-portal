<definition>
	<command name="addPG">
		<execute action="PGBookmarks#assertClick" locator-key1="HOME_MENU_ADD_FOLDER" value1="Add Folder" />

		<execute action="PGBookmarksAddfolder#type" locator-key1="NAME_FIELD" value1="${bookmarkFolderName}" />
		<execute action="PGBookmarksAddfolder#type" locator-key1="DESCRIPTION_FIELD" value1="${bookmarkFolderDescription}" />
		<execute action="PGBookmarksAddfolder#assertClick" locator-key1="SAVE_BUTTON" value1="Save" />

		<var name="key_folderName" value="${bookmarkFolderName}" />

		<execute action="PGBookmarks#assertTextEquals" locator-key1="SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute action="PGBookmarks#assertTextEquals" locator-key1="FOLDERS_TABLE_FOLDER_NAME" value1="${bookmarkFolderName}" />
		<execute action="PGBookmarks#assertTextEquals" locator-key1="FOLDERS_TABLE_FOLDER_DESCRIPTION" value1="${bookmarkFolderDescription}" />
	</command>

	<command name="deletePG" >
		<var name="key_folderName" value="${bookmarkFolderName}" />

		<execute action="PGBookmarks#assertClick" locator-key1="FOLDERS_TABLE_FOLDER_ACTIONS_BUTTON" value1="Actions" />
		<execute action="PGBookmarks#assertClick" locator-key1="FOLDER_MENULIST_DELETE" value1="Delete" />
		<execute action="PGBookmarks#confirm" locator-key1="CONFIRMATION" value1="Are you sure you want to delete this?" />
		<execute action="PGBookmarks#assertTextEquals" locator-key1="SUCCESS_MESSAGE" value1="Your request completed successfully." />
		<execute action="PGBookmarks#assertTextNotPresent" value1="${bookmarkFolderName}" />
	</command>

	<command name="tearDownCP">
		<execute macro="Page#gotoCP">
			<var name="portletName" value="Bookmarks" />
		</execute>

		<while>
			<condition action="CPBookmarks#isElementPresent" locator-key1="FOLDERS_TABLE_FOLDER_ACTIONS_BUTTON_GENERIC" />
			<then>
				<execute action="CPBookmarks#assertClick" locator-key1="FOLDERS_TABLE_FOLDER_ACTIONS_BUTTON_GENERIC" value1="Actions" />
				<execute action="CPBookmarks#assertClick" locator-key1="FOLDER_MENULIST_DELETE" value1="Delete" />
				<execute action="CPBookmarks#confirm" locator-key1="CONFIRMATION" value1="Are you sure you want to delete this?" />
				<execute action="CPBookmarks#assertTextEquals" locator-key1="SUCCESS_MESSAGE" value1="Your request completed successfully." />
			</then>
		</while>
	</command>
</definition>