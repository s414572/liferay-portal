<definition>
	<command name="addMicroblogsEntry">
		<execute action="SOUserBar#click" locator-key1="DASHBOARD" />

		<execute action="SODashboard#click" locator-key1="NAVIGATION_MICROBLOGS" />

		<if>
			<condition action="SOMicroblogs#isElementNotPresent" locator-key1="MICROBLOGS_ENTRY_CONTENT" />
			<then>
				<execute action="SOMicroblogs#assertTextEquals" locator-key1="INFO_MESSAGE" value1="You do not have any microblog entries." />
			</then>
		</if>

		<execute action="SOMicroblogs#click" locator-key1="MICROBLOGS_CONTENT_FIELD" />
		<execute action="SOMicroblogs#click" locator-key1="MICROBLOGS_CONTENT_INPUT_FIELD" />
		<execute action="SOMicroblogs#type" locator-key1="MICROBLOGS_CONTENT_INPUT_FIELD" value1="${microblogsEntryContent}" />
		<execute action="SOMicroblogs#assertTextEquals" locator-key1="MICROBLOGS_CONTENT_COUNTDOWN" value1="${microblogsEntryCharacterCountdown}" />
		<execute action="SOMicroblogs#select" locator-key1="MICROBLOGS_CONTENT_VIEW_FILTER" value1="${microblogsEntryViewableBy}" />
		<execute action="SOMicroblogs#click" locator-key1="POST_BUTTON" />
		<execute action="SOMicroblogs#assertTextEquals" locator-key1="MICROBLOGS_ENTRY_CONTENT" value1="${microblogsEntryContent}" />
	</command>

	<command name="addMicroblogsEntryMention">
		<execute action="SOUserBar#click" locator-key1="DASHBOARD" />

		<execute action="SODashboard#click" locator-key1="NAVIGATION_MICROBLOGS" />

		<if>
			<condition action="SOMicroblogs#isElementNotPresent" locator-key1="MICROBLOGS_ENTRY_CONTENT" />
			<then>
				<execute action="SOMicroblogs#assertTextEquals" locator-key1="INFO_MESSAGE" value1="You do not have any microblog entries." />
			</then>
		</if>

		<execute action="SOMicroblogs#click" locator-key1="MICROBLOGS_CONTENT_FIELD" />
		<execute action="SOMicroblogs#click" locator-key1="MICROBLOGS_CONTENT_INPUT_FIELD" />
		<execute action="SOMicroblogs#type" locator-key1="MICROBLOGS_CONTENT_INPUT_FIELD" value1="@${userFirstName}" />
		<execute action="SOMicroblogs#assertTextEquals" locator-key1="MICROBLOGS_CONTENT_AUTOCOMPLETE_USERNAME" value1="${userName}" />
		<execute action="SOMicroblogs#assertTextEquals" locator-key1="MICROBLOGS_CONTENT_AUTOCOMPLETE_EMAIL" value1="${userEmailAddress}" />
		<execute action="SOMicroblogs#click" locator-key1="MICROBLOGS_CONTENT_AUTOCOMPLETE_USERNAME" value1="${userEmailAddress}" />
		<execute action="SOMicroblogs#assertTextEquals" locator-key1="MICROBLOGS_CONTENT_COUNTDOWN" value1="${microblogsEntryCharacterCountdown}" />
		<execute action="SOMicroblogs#select" locator-key1="MICROBLOGS_CONTENT_VIEW_FILTER" value1="${microblogsEntryViewableBy}" />
		<execute action="SOMicroblogs#click" locator-key1="POST_BUTTON" />
		<execute action="SOMicroblogs#assertTextEquals" locator-key1="MICROBLOGS_ENTRY_CONTENT" value1="${userName}" />
	</command>

	<command name="addMicroblogsEntryHashtag">
		<execute action="SOUserBar#click" locator-key1="DASHBOARD" />

		<execute action="SODashboard#click" locator-key1="NAVIGATION_MICROBLOGS" />

		<if>
			<condition action="SOMicroblogs#isElementNotPresent" locator-key1="MICROBLOGS_ENTRY_CONTENT" />
			<then>
				<execute action="SOMicroblogs#assertTextEquals" locator-key1="INFO_MESSAGE" value1="You do not have any microblog entries." />
			</then>
		</if>

		<execute action="SOMicroblogs#click" locator-key1="MICROBLOGS_CONTENT_FIELD" />
		<execute action="SOMicroblogs#click" locator-key1="MICROBLOGS_CONTENT_INPUT_FIELD" />
		<execute action="SOMicroblogs#type" locator-key1="MICROBLOGS_CONTENT_INPUT_FIELD" value1="#${microblogsEntryContent}" />
		<execute action="SOMicroblogs#assertTextEquals" locator-key1="MICROBLOGS_CONTENT_COUNTDOWN" value1="${microblogsEntryCharacterCountdown}" />
		<execute action="SOMicroblogs#select" locator-key1="MICROBLOGS_CONTENT_VIEW_FILTER" value1="${microblogsEntryViewableBy}" />
		<execute action="SOMicroblogs#click" locator-key1="POST_BUTTON" />
		<execute action="SOMicroblogs#assertTextEquals" locator-key1="MICROBLOGS_ENTRY_CONTENT" value1="${microblogsEntryContent}" />
	</command>

	<command name="deleteMicroblogsEntry">
		<execute action="SOUserBar#click" locator-key1="DASHBOARD" />

		<execute action="SODashboard#click" locator-key1="NAVIGATION_MICROBLOGS" />

		<execute action="SOMicroblogs#mouseOver" locator-key1="MICROBLOGS_ENTRY_EDIT" />
		<execute action="SOMicroblogs#mouseOver" locator-key1="MICROBLOGS_ENTRY_DELETE" />
		<execute action="SOMicroblogs#click" locator-key1="MICROBLOGS_ENTRY_DELETE_LINK" value1="Delete" />
		<execute action="SOMicroblogs#confirm" locator-key1="CONFIRMATION" value1="Are you sure you want to delete this post?" />
	</command>

	<command name="tearDownMicroblogsEntry">
		<execute macro="SOUser#firstLoginPG" />

		<execute action="SOUserBar#click" locator-key1="DASHBOARD" />

		<execute action="SODashboard#click" locator-key1="NAVIGATION_MICROBLOGS" />

		<while>
			<condition action="SOMicroblogs#isElementPresent" locator-key1="MICROBLOGS_ENTRY_DELETE_LINK" value1="Delete" />
			<then>
				<execute action="SOMicroblogs#mouseOver" locator-key1="MICROBLOGS_ENTRY_EDIT" />
				<execute action="SOMicroblogs#mouseOver" locator-key1="MICROBLOGS_ENTRY_DELETE" />
				<execute action="SOMicroblogs#click" locator-key1="MICROBLOGS_ENTRY_DELETE_LINK" value1="Delete" />
				<execute action="SOMicroblogs#confirm" locator-key1="CONFIRMATION" value1="Are you sure you want to delete this post?" />
			</then>
		</while>
	</command>

	<command name="viewMicroblogsEntryViewableByEveryone">
		<execute action="SOUserBar#click" locator-key1="DASHBOARD" />

		<execute action="SODashboard#click" locator-key1="NAVIGATION_CONTACTS_CENTER" />

		<execute action="SOContactscenter#type" locator-key1="CONTACTS_LIST_SEARCH" value1="${microblogsEntryAuthorScreenName}" />
		<execute action="SOContactscenter#assertClick" locator-key1="CONTACTS_LIST_NAME" value1="${microblogsEntryAuthorLastName}, ${microblogsEntryAuthorFirstName}" />

		<if>
			<isset var="microblogsEntryAuthorMiddleName" />
			<then>
				<execute action="SOContactscenter#assertClick" locator-key1="USER_DETAILS_NAME" value1="${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorMiddleName} ${microblogsEntryAuthorLastName}" />
			</then>
			<else>
				<execute action="SOContactscenter#assertClick" locator-key1="USER_DETAILS_NAME" value1="${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorLastName}" />
			</else>
		</if>

		<execute action="SOProfile#assertTextEquals" locator-key1="WHATS_HAPPENING_ENTRY_CONTENT" value1="${microblogsEntryContent}" />

		<execute action="SOProfile#click" locator-key1="NAVIGATION_MICROBLOGS" />

		<if>
			<isset var="microblogsEntryAuthorMiddleName" />
			<then>
				<execute action="PGProfileMicroblogs#assertTextEquals" locator-key1="MICROBLOGS_ENTRY_AUTHOR" value1="${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorMiddleName} ${microblogsEntryAuthorLastName}" />
			</then>
			<else>
				<execute action="PGProfileMicroblogs#assertTextEquals" locator-key1="MICROBLOGS_ENTRY_AUTHOR" value1="${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorLastName}" />
			</else>
		</if>

		<execute action="PGProfileMicroblogs#assertTextEquals" locator-key1="MICROBLOGS_ENTRY_CONTENT" value1="${microblogsEntryContent}" />
		<execute action="PGProfileMicroblogs#assertTextEquals" locator-key1="MICROBLOGS_ENTRY_COMMENT_LINK" value1="Comment" />
		<execute action="PGProfileMicroblogs#assertTextEquals" locator-key1="MICROBLOGS_ENTRY_REPOST_LINK" value1="Repost" />
		<execute action="PGProfileMicroblogs#assertElementNotPresent" locator-key1="MICROBLOGS_ENTRY_EDIT_LINK" value1="Edit" />
		<execute action="PGProfileMicroblogs#assertElementNotPresent" locator-key1="MICROBLOGS_ENTRY_DELETE_LINK" value1="Delete" />
	</command>

	<command name="viewOwnMicroblogsEntry">
		<execute action="SOUserBar#click" locator-key1="DASHBOARD" />

		<execute action="SODashboard#assertTextEquals" locator-key1="WHATS_HAPPENING_ENTRY_CONTENT" value1="${microblogsEntryContent}" />

		<execute action="SODashboard#click" locator-key1="NAVIGATION_MICROBLOGS" />

		<if>
			<isset var="microblogsEntryAuthorMiddleName" />
			<then>
				<execute action="SOMicroblogs#assertTextEquals" locator-key1="MICROBLOGS_ENTRY_AUTHOR" value1="${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorMiddleName} ${microblogsEntryAuthorLastName}" />
			</then>
			<else>
				<execute action="SOMicroblogs#assertTextEquals" locator-key1="MICROBLOGS_ENTRY_AUTHOR" value1="${microblogsEntryAuthorFirstName} ${microblogsEntryAuthorLastName}" />
			</else>
		</if>

		<execute action="SOMicroblogs#assertTextEquals" locator-key1="MICROBLOGS_ENTRY_CONTENT" value1="${microblogsEntryContent}" />
		<execute action="SOMicroblogs#assertTextEquals" locator-key1="MICROBLOGS_ENTRY_COMMENT_LINK" value1="Comment" />
		<execute action="SOMicroblogs#assertElementNotPresent" locator-key1="MICROBLOGS_ENTRY_REPOST_LINK" value1="Repost" />
	</command>
</definition>